{
  "name": "cloudox-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Public website for CloudoX — the intelligent cloud knowledge platform.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "cover": "node scripts/generate-cover.mjs",
    "assets": "node scripts/generate-raster-assets.mjs",
    "assets:check": "node scripts/generate-raster-assets.mjs --check",
    "test:unit": "node --experimental-strip-types --test tests/legal-config.test.ts",
    "test": "PUBLIC_WEB3FORMS_KEY=test-key-for-static-assertions npm run build && node --experimental-strip-types --test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.2.5",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.4.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.7",
    "astro": "^5.7.13",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3"
  }
}
