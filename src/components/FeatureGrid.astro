---
import FeatureCard from "./FeatureCard.astro";

interface Feature {
  title: string;
  description: string;
  icon?: string;
  href?: string;
}

interface Props {
  features: Feature[];
  cols?: 2 | 3 | 4;
}

const { features, cols = 3 } = Astro.props as Props;
const colsClass =
  cols === 2
    ? "sm:grid-cols-2"
    : cols === 4
    ? "sm:grid-cols-2 lg:grid-cols-4"
    : "sm:grid-cols-2 lg:grid-cols-3";
---

<div class={`grid gap-5 ${colsClass}`}>
  {features.map((f) => (
    <FeatureCard
      title={f.title}
      description={f.description}
      icon={f.icon}
      href={f.href}
    />
  ))}
</div>
