---
interface Props {
  title: string;
  subtitle?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}

const { title, subtitle, primary, secondary } = Astro.props as Props;
---

<section class="py-20 md:py-24">
  <div class="container-page">
    <div
      class="surface relative overflow-hidden p-8 md:p-12 text-center"
      style="background: linear-gradient(135deg, color-mix(in oklab, var(--accent) 10%, var(--bg-elevated)) 0%, var(--bg-elevated) 60%);"
    >
      <div class="absolute inset-0 grid-bg opacity-40 pointer-events-none" aria-hidden="true"></div>
      <div class="relative">
        <h2 class="text-2xl md:text-4xl font-semibold tracking-tight max-w-2xl mx-auto">
          {title}
        </h2>
        {subtitle && (
          <p class="mt-4 muted max-w-2xl mx-auto leading-relaxed">{subtitle}</p>
        )}
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          {primary && (
            <a href={primary.href} class="btn btn-primary">
              {primary.label}
            </a>
          )}
          {secondary && (
            <a href={secondary.href} class="btn btn-secondary">
              {secondary.label}
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
