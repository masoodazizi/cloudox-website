---
interface Layer {
  name: string;
  description: string;
  details: string[];
}

interface Props {
  layers: Layer[];
}

const { layers } = Astro.props as Props;
---

<div class="grid md:grid-cols-2 gap-5">
  {layers.map((layer, i) => (
    <div class="surface p-6">
      <div class="flex items-center gap-3 mb-3">
        <span
          class="inline-flex h-8 w-8 items-center justify-center rounded-md font-mono text-sm"
          style="background: color-mix(in oklab, var(--accent) 12%, transparent); color: var(--accent);"
          aria-hidden="true"
        >
          {i + 1}
        </span>
        <h3 class="text-base font-semibold">{layer.name}</h3>
      </div>
      <p class="text-sm muted leading-relaxed mb-4">{layer.description}</p>
      <ul class="text-sm space-y-1.5">
        {layer.details.map((d) => (
          <li class="flex gap-2 muted">
            <span aria-hidden="true" style="color: var(--accent);">·</span>
            <span>{d}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
