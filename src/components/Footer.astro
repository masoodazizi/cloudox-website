---
import Logo from "./Logo.astro";
import { FOOTER_NAV, LEGAL_NAV, SITE } from "@/config/site";
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t" style="border-color: var(--border); background-color: var(--bg-muted);">
  <div class="container-page py-14 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-5 space-y-4">
      <Logo size="lg" loading="lazy" />
      <p class="text-sm muted max-w-sm">
        The intelligent cloud knowledge platform. Understand any cloud
        environment in under 30 minutes — AWS-first today, multi-cloud tomorrow.
      </p>
      <p class="text-xs muted">
        Knowledge-first. Evidence-grounded. AI-assisted, not AI-invented.
      </p>
    </div>

    <div class="md:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-6">
      {FOOTER_NAV.map((column) => (
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-[0.14em] mb-3" style="color: var(--fg);">
            {column.title}
          </h4>
          <ul class="space-y-2">
            {column.items.map((item) => (
              <li>
                <a href={item.href} class="text-sm muted hover:underline">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="border-t" style="border-color: var(--border);">
    <div class="container-page py-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs muted">
      <p>© {year} {SITE.name}. All rights reserved.</p>
      <div class="flex flex-col sm:flex-row sm:items-center gap-x-5 gap-y-2">
        <p>Built for the people who run cloud.</p>
        <p class="inline-flex items-center gap-1.5">
          <svg width="16" height="11" viewBox="0 0 5 3" aria-hidden="true" class="rounded-[1px]">
            <rect width="5" height="1" y="0" fill="#000000"></rect>
            <rect width="5" height="1" y="1" fill="#DD0000"></rect>
            <rect width="5" height="1" y="2" fill="#FFCE00"></rect>
          </svg>
          <span>Made in Germany</span>
        </p>
      </div>
    </div>
  </div>

  <div class="border-t" style="border-color: var(--border);">
    <div class="container-page py-4">
      <nav aria-label="Legal" class="flex flex-wrap gap-x-5 gap-y-2 text-xs">
        {LEGAL_NAV.map((item) => (
          <a
            href={item.href}
            class="muted hover:underline"
            style="text-underline-offset: 2px;"
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>
