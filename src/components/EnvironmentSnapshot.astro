---
/**
 * The product-proof composition: one real (sanitized) environment as CloudoX
 * describes it — the account structure it named, the figures it reports with
 * their basis, and one finding traced to the resource it came from.
 *
 * Everything here is quoted from the published example report via
 * `src/config/example.ts`. Nothing is illustrative, and no figure appears
 * without the basis that qualifies it.
 */
import ConfidenceBadge from "./ConfidenceBadge.astro";
import {
  EXAMPLE,
  EXAMPLE_ACCOUNTS,
  EXAMPLE_EVIDENCE,
} from "@/config/example";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props as Props;

/** The four headline figures, each with the short form of its basis. */
const figures = [
  { value: "833", label: "resources", note: "lower bound" },
  { value: "6 of 7", label: "accounts in scope", note: "1 excluded" },
  { value: "2", label: "regions observed", note: "primary + DR" },
  { value: "4 of 5", label: "workloads significant", note: "1 demoted" },
];
---

<figure class={`canvas overflow-hidden ${className}`} style="margin: 0;">
  <div
    class="flex items-center justify-between gap-3 px-4 py-2.5 text-xs"
    style="border-bottom: 1px solid var(--canvas-border);"
  >
    <span class="inline-flex items-center gap-2 canvas-muted">
      <span
        class="inline-block h-1.5 w-1.5 rounded-full"
        style="background: var(--conf-verified);"
        aria-hidden="true"></span>
      Sanitized example · real AWS environment
    </span>
    <span class="font-mono canvas-muted">{EXAMPLE.generatedAtLabel}</span>
  </div>

  <div class="p-4 sm:p-5 space-y-5">
    <!-- Account structure, as CloudoX named it -->
    <div>
      <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.12em] canvas-muted mb-2.5">
        Accounts, as CloudoX named them
      </p>
      <ul class="grid grid-cols-2 gap-1.5 sm:grid-cols-3">
        {EXAMPLE_ACCOUNTS.map((account) => (
          <li class="canvas-panel px-2.5 py-2">
            <span class="block text-xs font-medium leading-tight">{account.name}</span>
            <span class="mt-1 flex items-center justify-between gap-1">
              <span class="font-mono text-[0.625rem] canvas-muted">{account.id}</span>
              <span
                class="text-[0.625rem] font-medium"
                style={`color: var(--conf-${account.confidence.toLowerCase()});`}
              >
                {account.confidence}
              </span>
            </span>
          </li>
        ))}
      </ul>
      <p class="mt-2 text-[0.6875rem] canvas-muted leading-relaxed">
        Human names derived from evidence — organization structure, aliases,
        tags — with the raw identifier kept beside them and a confidence label
        on each.
      </p>
    </div>

    <!-- Headline figures, each with its basis attached -->
    <div>
      <dl class="grid grid-cols-2 gap-1.5 sm:grid-cols-4">
        {figures.map((figure) => (
          <div class="canvas-panel px-2.5 py-2">
            <dt class="text-[0.625rem] canvas-muted leading-tight">{figure.label}</dt>
            <dd class="mt-0.5 text-lg font-semibold leading-none">{figure.value}</dd>
            <dd class="mt-1 text-[0.625rem] canvas-muted leading-tight">{figure.note}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-2 text-[0.6875rem] canvas-muted leading-relaxed">
        Two collectors were unavailable on this run, so the resource count is
        published as a lower bound rather than a full inventory.
      </p>
    </div>

    <!-- One finding, traced back to the resource it came from -->
    <div class="canvas-panel p-3">
      <div class="flex flex-wrap items-start justify-between gap-2 mb-3">
        <p class="text-xs font-medium leading-snug max-w-sm">{EXAMPLE_EVIDENCE.finding}</p>
        <ConfidenceBadge level={EXAMPLE_EVIDENCE.confidence} />
      </div>
      <ol class="space-y-1.5">
        {EXAMPLE_EVIDENCE.trail.map((node, i) => (
          <li class="flex items-start gap-2 text-[0.6875rem] leading-snug">
            <span
              class="mt-1 inline-block h-1.5 w-1.5 shrink-0 rounded-full"
              style={`background: ${i === EXAMPLE_EVIDENCE.trail.length - 1 ? "var(--conf-verified)" : "var(--canvas-fg-muted)"};`}
              aria-hidden="true"></span>
            <span>
              <span class="canvas-muted">{node.step}:</span>{" "}
              <span class={i === EXAMPLE_EVIDENCE.trail.length - 1 ? "font-mono" : ""}>
                {node.detail}
              </span>
            </span>
          </li>
        ))}
      </ol>
      <p
        class="mt-3 pt-2.5 text-[0.6875rem] canvas-muted leading-relaxed"
        style="border-top: 1px solid var(--canvas-border);"
      >
        Since the previous run: 1 security group became internet-reachable,
        1 stopped being reachable. Both stated as observed change, neither
        explained away.
      </p>
    </div>
  </div>

  <figcaption
    class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 text-xs"
    style="border-top: 1px solid var(--canvas-border); background: color-mix(in oklab, var(--canvas-elevated) 60%, transparent);"
  >
    <span class="canvas-muted">
      Identifiers replaced with synthetic equivalents. Architecture and findings
      unmodified.
    </span>
    <a
      href={EXAMPLE.previewUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="font-medium underline"
      style="color: var(--color-brand-400); text-underline-offset: 3px;"
    >
      Read the full example →
    </a>
  </figcaption>
</figure>
