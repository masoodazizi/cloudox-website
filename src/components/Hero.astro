---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const {
  eyebrow,
  title,
  subtitle,
  primaryCta,
  secondaryCta,
} = Astro.props as Props;
---

<section class="relative overflow-hidden">
  <div class="absolute inset-0 grid-bg opacity-60 pointer-events-none" aria-hidden="true"></div>

  <div
    class="absolute inset-x-0 -top-32 h-96 pointer-events-none"
    style="background: radial-gradient(60% 60% at 50% 0%, color-mix(in oklab, var(--accent) 30%, transparent), transparent);"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative pt-20 pb-16 md:pt-28 md:pb-24">
    {eyebrow && <p class="eyebrow mb-5">{eyebrow}</p>}
    <h1 class="text-4xl md:text-6xl font-semibold tracking-tight max-w-4xl">
      {title}
    </h1>
    {subtitle && (
      <p class="mt-6 text-lg md:text-xl muted max-w-2xl leading-relaxed">
        {subtitle}
      </p>
    )}

    {(primaryCta || secondaryCta) && (
      <div class="mt-9 flex flex-wrap gap-3">
        {primaryCta && (
          <a href={primaryCta.href} class="btn btn-primary">
            {primaryCta.label}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        )}
        {secondaryCta && (
          <a href={secondaryCta.href} class="btn btn-secondary">
            {secondaryCta.label}
          </a>
        )}
      </div>
    )}

    <slot />
  </div>
</section>
