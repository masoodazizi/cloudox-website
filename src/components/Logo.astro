---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props as Props;
---

<a
  href="/"
  class={`inline-flex items-center gap-2 font-semibold tracking-tight ${className}`}
  aria-label="Cloudox home"
>
  <svg
    width="28"
    height="28"
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="cloudoxLogo" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="var(--color-brand-500)" />
        <stop offset="100%" stop-color="var(--color-brand-700)" />
      </linearGradient>
    </defs>
    <rect x="2" y="2" width="28" height="28" rx="7" fill="url(#cloudoxLogo)" />
    <path
      d="M9 19.5c0-2.3 1.85-4.16 4.13-4.2A5 5 0 0 1 22.5 13a3 3 0 0 1 .5 5.96"
      stroke="white"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />
    <circle cx="11" cy="22.5" r="1.1" fill="white" />
    <circle cx="16" cy="22.5" r="1.1" fill="white" />
    <circle cx="21" cy="22.5" r="1.1" fill="white" />
  </svg>
  <span class="text-base">Cloudox</span>
</a>
