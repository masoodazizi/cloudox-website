---
interface Props {
  class?: string;
  withWordmark?: boolean;
  size?: "sm" | "md" | "lg";
}

const {
  class: className = "",
  withWordmark = true,
  size = "md",
} = Astro.props as Props;

const sizeClasses = {
  sm: { box: "h-6", text: "text-base" },
  md: { box: "h-7", text: "text-lg" },
  lg: { box: "h-9", text: "text-2xl" },
}[size];
---

<a
  href="/"
  class={`inline-flex items-center gap-2.5 font-semibold tracking-tight ${className}`}
  aria-label="CloudoX home"
>
  <svg
    class={sizeClasses.box}
    viewBox="0 0 64 48"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M14 35h-1.5a8.5 8.5 0 0 1-1.4-16.88A11 11 0 0 1 32.4 14"
      stroke="currentColor"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />
    <rect
      x="24"
      y="14"
      width="26"
      height="28"
      rx="2.5"
      stroke="currentColor"
      stroke-width="2.6"
      stroke-linejoin="round"
      fill="none"
    />
    <line x1="29" y1="22" x2="45" y2="22" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
    <line x1="29" y1="28" x2="45" y2="28" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
    <line x1="29" y1="34" x2="40" y2="34" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
  </svg>

  {withWordmark && (
    <span class={`leading-none ${sizeClasses.text}`}>
      Cloudo<span style="color: var(--accent);">X</span>
    </span>
  )}
</a>
