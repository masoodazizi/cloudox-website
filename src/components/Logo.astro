---
/**
 * CloudoX wordmark and icon.
 *
 * Uses the official PNG brand pack from `public/brand/logo/`. The bright
 * variant is designed for light backgrounds; the dark variant is designed
 * for dark backgrounds. We swap between them via `prefers-color-scheme`
 * inside a <picture> element so the right asset loads automatically.
 *
 * Variants:
 *   - default      (icon + "CloudoX" wordmark)
 *   - icon-only    (just the cloud + document mark)
 *   - with-tagline (full lockup including "Cloud Discovery, Intelligent Documentation.")
 */

interface Props {
  class?: string;
  /** Visual variant. */
  variant?: "wordmark" | "icon" | "tagline";
  /** Header / footer / hero scale. */
  size?: "sm" | "md" | "lg" | "xl";
  /**
   * Hint to the browser whether this image is critical (above-the-fold).
   * Defaults to "eager" since logos are typically in the header.
   */
  loading?: "eager" | "lazy";
  /** Override link target. Set to `false` to render without an <a> wrapper. */
  href?: string | false;
}

const {
  class: className = "",
  variant = "wordmark",
  size = "md",
  loading = "eager",
  href = "/",
} = Astro.props as Props;

// Natural pixel dimensions used for aspect-ratio attributes (prevents CLS).
const ASSETS = {
  wordmark: {
    bright: "/brand/logo/logo-v1-bright.png",
    dark: "/brand/logo/logo-v1-dark.png",
    intrinsic: { width: 892, height: 210 },
  },
  icon: {
    bright: "/brand/logo/logo-v1-icon-bright.png",
    dark: "/brand/logo/logo-v1-icon-dark.png",
    intrinsic: { width: 294, height: 205 },
  },
  tagline: {
    bright: "/brand/logo/logo-v1-sub-bright.png",
    dark: "/brand/logo/logo-v1-sub-dark.png",
    intrinsic: { width: 890, height: 275 },
  },
} as const;

// Rendered height (in px) per size for each variant. Width follows from the
// intrinsic aspect ratio.
const HEIGHT_BY_SIZE = {
  wordmark: { sm: 22, md: 28, lg: 36, xl: 48 },
  icon: { sm: 22, md: 28, lg: 36, xl: 48 },
  tagline: { sm: 36, md: 48, lg: 64, xl: 96 },
} as const;

const asset = ASSETS[variant];
const height = HEIGHT_BY_SIZE[variant][size];
const width = Math.round((asset.intrinsic.width / asset.intrinsic.height) * height);

const Tag = href === false ? "span" : "a";
const linkProps = href === false ? {} : { href };
---

<Tag
  {...linkProps}
  class={`inline-flex items-center ${className}`}
  aria-label="CloudoX home"
>
  <picture>
    <source srcset={asset.dark} media="(prefers-color-scheme: dark)" />
    <img
      src={asset.bright}
      alt="CloudoX"
      width={width}
      height={height}
      style={`height: ${height}px; width: auto;`}
      loading={loading}
      decoding="async"
      draggable="false"
    />
  </picture>
</Tag>
