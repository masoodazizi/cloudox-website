---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import { SITE } from "@/config/site";
import { EXAMPLE } from "@/config/example";

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home",      item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Use Cases", item: `${SITE.url}/use-cases/` },
  ],
};

/**
 * Decision moments, not personas. The audience lenses are shown on the home
 * page; repeating them here said the same thing twice. Each entry names a
 * moment someone actually has to decide something, what they do about it
 * today, and which shipped artifact replaces that work.
 */
const moments = [
  {
    moment: "Taking over an environment you did not build",
    today:
      "Days of console tabs and tribal knowledge, ending in a diagram nobody trusts a month later.",
    instead:
      "A workload-level model of accounts, regions, exposure, and dependencies, with the raw identifier behind every name.",
    decision: "Where to start, and what not to touch yet.",
    view: "Architect view",
  },
  {
    moment: "Preparing an architecture review",
    today:
      "Someone hand-assembles slides from screenshots, and the review argues about the picture instead of the design.",
    instead:
      "Deterministic reference tables — routing, connectivity, ingress, trust, dependencies — beside the interpreted architecture.",
    decision: "Which design risks are real and worth review time.",
    view: "Architect + Operations views",
  },
  {
    moment: "Answering “what is exposed?” credibly",
    today:
      "A scanner's finding list, with no way to separate proven exposure from a plausible guess.",
    instead:
      "Ingress paths backed by the security-group rule and resource that produced them, each carrying a confidence label — and an explicit list of what evidence could not answer.",
    decision: "What to fix now versus what to go verify first.",
    view: "Security view",
  },
  {
    moment: "Explaining a bill nobody can attribute",
    today:
      "Cost Explorer says which services cost money; nobody can say which workloads caused it.",
    instead:
      "Spend associated to accounts and regions as billing fact, and a cost-pressure ranking that says which workloads deserve investigation first — never a fabricated per-workload dollar figure.",
    decision: "Which workload to investigate first.",
    view: "FinOps view",
  },
  {
    moment: "Reviewing what changed since last time",
    today:
      "Change is reconstructed from memory, CloudTrail, and whoever happens to remember the migration.",
    instead:
      "A diff of two discovery runs: resources, relationships, scope, and internet exposure added or removed, stated as observed change.",
    decision: "Whether a change was intentional.",
    view: "Change tracking",
  },
  {
    moment: "Briefing leadership without an inventory dump",
    today:
      "A technical deck gets summarised upward, and the caveats fall off on the way.",
    instead:
      "The decisions that need attention, in plain language, with the same confidence labels the engineers saw — including where coverage was incomplete.",
    decision: "What leadership actually has to decide.",
    view: "Executive view",
  },
];

/** Being explicit about the boundary is what makes the rest credible. */
const notFor = [
  {
    title: "Not a CMDB",
    body: "CloudoX explains an environment; it is not the authoritative asset register you reconcile against finance.",
  },
  {
    title: "Not a security scanner",
    body: "It reports exposure it can prove from configuration. It does not scan for vulnerabilities, test payloads, or rank CVEs.",
  },
  {
    title: "Not a FinOps platform",
    body: "It puts spend in architectural context. Cost Explorer, CUR analysis, forecasting, and budgets stay where they are.",
  },
  {
    title: "Not a monitoring tool",
    body: "It reads configuration, not runtime telemetry — so utilization-based recommendations are out of scope, and it says so.",
  },
];
---

<BaseLayout
  title="Use Cases — The decisions CloudoX helps you make"
  description="Six moments where CloudoX replaces guesswork: taking over an unfamiliar AWS environment, architecture review, exposure questions, unattributable cost, change review, and briefing leadership."
  jsonLd={[breadcrumb]}
>
  <Hero
    eyebrow="USE CASES"
    title="Six moments where guessing is expensive."
    subtitle="CloudoX is worth using when a decision depends on understanding an AWS environment you cannot fully see. Each moment below names what that costs today and which artifact replaces it."
    primaryCta={{ label: "Explore the real example", href: EXAMPLE.previewUrl }}
    secondaryCta={{ label: "Request early access", href: "/contact" }}
  />

  <Section>
    <div class="grid gap-5 lg:grid-cols-2">
      {moments.map((m) => (
        <article class="surface flex flex-col p-6">
          <h2 class="text-base font-semibold">{m.moment}</h2>
          <dl class="mt-4 space-y-3 text-sm">
            <div>
              <dt class="text-xs uppercase tracking-wide muted">Today</dt>
              <dd class="mt-1 muted leading-relaxed">{m.today}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide muted">With CloudoX</dt>
              <dd class="mt-1 leading-relaxed">{m.instead}</dd>
            </div>
          </dl>
          <p class="mt-4 pt-4 text-sm" style="border-top: 1px solid var(--border);">
            <span class="font-medium" style="color: var(--accent);">Decision it supports:</span>{" "}
            <span class="muted">{m.decision}</span>
          </p>
          <p class="mt-2 text-xs muted">{m.view}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section
    id="boundaries"
    eyebrow="WHERE IT IS NOT THE RIGHT TOOL"
    title="Four things CloudoX deliberately is not."
    subtitle="A tool that claims every job is a tool you cannot check. These boundaries are the same ones the product enforces in its own output."
    muted
  >
    <div class="grid gap-5 md:grid-cols-2">
      {notFor.map((n) => (
        <div class="surface p-6">
          <h3 class="text-sm font-semibold">{n.title}</h3>
          <p class="mt-2 text-sm muted leading-relaxed">{n.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-sm muted max-w-2xl leading-relaxed">
      <a href="/security" class="font-medium" style="color: var(--accent);">What CloudoX can and cannot access, exactly →</a>
    </p>
  </Section>

  <CTA
    title="See these artifacts on a real environment."
    primary={{ label: "Explore the real example", href: EXAMPLE.previewUrl }}
    secondary={{ label: "Request early access", href: "/contact" }}
  />
</BaseLayout>
