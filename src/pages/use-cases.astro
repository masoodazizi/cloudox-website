---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import { SITE } from "@/config/site";

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home",      item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Use Cases", item: `${SITE.url}/use-cases/` },
  ],
};

const useCases = [
  {
    persona: "Consultants & solutions architects",
    view: "Architect & Executive views",
    title: "Walk into an engagement already understanding the environment.",
    bullets: [
      "Run CloudoX against a customer's AWS Organization with read-only access.",
      "Open the Architect view for workloads and design risks; hand the Executive view to leadership.",
      "Validate findings during the workshop — not chase console screenshots.",
    ],
  },
  {
    persona: "Cloud architects & engineers",
    view: "Architect view",
    title: "Get oriented in an unfamiliar environment in 30 minutes.",
    bullets: [
      "Identify production workloads, dependencies, and design risks fast.",
      "See how environments and accounts are organized across regions.",
      "Start from interpreted architecture, not a flat resource list.",
    ],
  },
  {
    persona: "Platform & DevOps engineers",
    view: "Operations view",
    title: "Operational documentation that writes itself.",
    bullets: [
      "Map connectivity, routing, and shared services across accounts.",
      "Spot missing observability, backup gaps, and recovery risks.",
      "Keep a current operational picture as the environment changes.",
    ],
  },
  {
    persona: "Security teams",
    view: "Security view",
    title: "See what's exposed — and what you can't yet prove.",
    bullets: [
      "Surface internet exposure and identity boundaries with evidence.",
      "Find governance gaps and the places evidence is missing.",
      "Every finding is labelled by confidence, never an aggressive guess.",
    ],
  },
  {
    persona: "FinOps & finance",
    view: "FinOps view",
    title: "Understand the spend behind the architecture.",
    bullets: [
      "See cost drivers connected to the workloads that cause them.",
      "Get optimization opportunities worth validating, in context.",
      "Complements Cost Explorer and FinOps tooling — it doesn't replace it.",
    ],
  },
  {
    persona: "Engineering leadership",
    view: "Executive view",
    title: "Risk and decisions without the inventory.",
    bullets: [
      "Read the highest risks and what needs leadership attention.",
      "Understand cost and change at a glance, in plain language.",
      "Make decisions from evidence-grounded understanding, not raw data.",
    ],
  },
];
---

<BaseLayout
  title="Use Cases — Executives, Architects, Operations, Security & FinOps"
  description="How executives, architects, platform and DevOps engineers, security teams, FinOps, and consultants use CloudoX and its Knowledge Views to understand AWS environments fast."
  jsonLd={[breadcrumb]}
>
  <Hero
    eyebrow="USE CASES"
    title="One environment, understood by everyone who needs to."
    subtitle="CloudoX builds a shared knowledge foundation, then frames it for each audience. The same discovery serves the architect, the operator, the security lead, finance, and the CTO."
    primaryCta={{ label: "Request Early Access", href: "/contact" }}
    secondaryCta={{ label: "Explore Knowledge Views", href: "/knowledge-views" }}
  />

  <Section>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {useCases.map((u) => (
        <article class="surface flex flex-col p-6">
          <p class="eyebrow mb-2">{u.persona}</p>
          <h3 class="text-base font-semibold mb-3">{u.title}</h3>
          <ul class="space-y-2 text-sm muted mb-4">
            {u.bullets.map((b) => (
              <li class="flex gap-2">
                <span aria-hidden="true" style="color: var(--accent);">›</span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
          <p class="mt-auto text-xs font-medium" style="color: var(--accent);">{u.view}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section
    eyebrow="ONE FOUNDATION, MANY READERS"
    title="The same truth, told the way each audience needs it."
    subtitle="Because CloudoX builds a shared knowledge graph and interprets it once, every audience reads the same facts — framed for their questions, never re-derived into a different story."
    muted
  >
    <p class="text-sm muted max-w-2xl leading-relaxed">
      Consultants, architects, and engineers remain the audience CloudoX is built
      for first. But the moment the knowledge foundation exists, it can serve
      security, operations, finance, and leadership from the same source of truth —
      which is exactly what Knowledge Views do today.
    </p>
  </Section>

  <CTA
    title="Ready to try CloudoX on a real environment?"
    primary={{ label: "Request Early Access", href: "/contact" }}
    secondary={{ label: "Book a call", href: SITE.bookingUrl }}
  />
</BaseLayout>
