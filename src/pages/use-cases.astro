---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import { SITE } from "@/config/site";

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home",      item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Use Cases", item: `${SITE.url}/use-cases/` },
  ],
};

const useCases = [
  {
    persona: "Consultants & solutions architects",
    title: "Ship a discovery report on day one of an engagement.",
    bullets: [
      "Run CloudoX against a customer's AWS Organization with read-only access.",
      "Walk into kickoff with a structured Markdown report instead of a blank slate.",
      "Validate findings during the workshop — not chase console screenshots.",
    ],
  },
  {
    persona: "Cloud engineers inheriting an environment",
    title: "Get oriented in an unfamiliar environment in 30 minutes.",
    bullets: [
      "Identify production workloads, internet-facing systems, and unclear ownership.",
      "Understand how environments and accounts are organized.",
      "Get a baseline of findings, risks, and assumptions to share with the team.",
    ],
  },
  {
    persona: "Cloud platform & SRE teams",
    title: "Audit your own AWS Organization without manual spelunking.",
    bullets: [
      "Catalog accounts, environments, and workloads across regions.",
      "Detect unmanaged exposure, missing observability, and tagging gaps.",
      "Use the report as a starting point for governance conversations.",
    ],
  },
];
---

<BaseLayout
  title="Use Cases — Consultants, Cloud Engineers & Platform Teams"
  description="How consultants, cloud engineers, and platform teams use CloudoX to understand AWS environments faster and generate stakeholder-ready discovery reports."
  jsonLd={[breadcrumb]}
>
  <Hero
    eyebrow="USE CASES"
    title="Built for the people who walk into unfamiliar cloud environments."
    subtitle="Technical stakeholders come first — consultants, architects, and engineers who need to understand an environment fast."
    primaryCta={{ label: "Request Early Access", href: "/contact" }}
    secondaryCta={{ label: "Book a call", href: SITE.bookingUrl }}
  />

  <Section>
    <div class="grid gap-5 md:grid-cols-3">
      {useCases.map((u) => (
        <article class="surface p-6">
          <p class="eyebrow mb-2">{u.persona}</p>
          <h3 class="text-base font-semibold mb-3">{u.title}</h3>
          <ul class="space-y-2 text-sm muted">
            {u.bullets.map((b) => (
              <li class="flex gap-2">
                <span aria-hidden="true" style="color: var(--accent);">›</span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </Section>

  <Section
    eyebrow="ONE KNOWLEDGE FOUNDATION, MANY READERS"
    title="The same knowledge serves more of the team over time."
    subtitle="CloudoX is built for technical stakeholders first. Because it builds a shared knowledge graph rather than a single document, the same understanding can serve more audiences as the platform grows."
    muted
  >
    <p class="text-sm muted max-w-2xl leading-relaxed">
      Security, operations, engineering leadership, and FinOps stakeholders all
      ask different questions of the same environment. Tailored views for those
      audiences are a direction on the roadmap — not a feature available today —
      built on the one source of truth CloudoX already produces.
    </p>
  </Section>

  <CTA
    title="Ready to try CloudoX on a real environment?"
    primary={{ label: "Request Early Access", href: "/contact" }}
    secondary={{ label: "Book a call", href: SITE.bookingUrl }}
  />
</BaseLayout>
