---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import FeatureGrid from "@components/FeatureGrid.astro";
import CTA from "@components/CTA.astro";
import { SITE } from "@/config/site";

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home",    item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Product", item: `${SITE.url}/product/` },
  ],
};

const features = [
  {
    title: "Multi-account, multi-region discovery",
    description:
      "Discover the AWS Organization tree, accounts, and shared services across regions. Deep collectors cover the architecture-critical services; a broader sweep keeps the long tail from disappearing — and the report names what it did and didn't see.",
  },
  {
    title: "Typed knowledge graph",
    description:
      "Resources, environments, workloads, and systems are first-class entities with explicit, evidence-bearing relationships — the canonical record of what was discovered.",
  },
  {
    title: "Interpretation",
    description:
      "Deterministic logic classifies environments, groups workloads, and detects internet exposure — so the output explains how the environment works, not just what exists.",
  },
  {
    title: "Intelligent documentation",
    description:
      "Predictable Markdown structure — executive summary, architecture, networking, security, observability, findings, and assumptions — backed by a built-in quality check that flags ungrounded claims before you ship.",
  },
  {
    title: "Architecture visualization",
    description:
      "Diagrams generated from the knowledge graph — architecture, networking, and account structure — embedded in the report to support understanding.",
  },
  {
    title: "Dashboard experience",
    description:
      "Browse the same knowledge in a hosted, read-only dashboard with navigation, search, and theming — a public preview is live today.",
  },
];

const beyond = [
  {
    title: "Environment Evolution",
    description:
      "Compare a discovery run against the previous one and read what actually changed — new regions and services, a workload that grew, an exposure that opened. A first version is available today.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><path d="M11 18H8a2 2 0 0 1-2-2V9"/></svg>`,
    badge: "First version",
  },
  {
    title: "Cost Intelligence",
    description:
      "Explain spend in the context of the architecture CloudoX already understands — the patterns behind the bill, not a replacement for Cost Explorer or FinOps tooling. A first version is available today.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
    badge: "First version",
  },
];

const reportingTargets = [
  {
    title: "CloudoX Dashboard",
    description:
      "Browse reports with sidebar navigation, search, and theming. A public preview is live with a sanitised example report.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="14" rx="2"/><line x1="2" y1="9" x2="22" y2="9"/><line x1="9" y1="14" x2="15" y2="14"/></svg>`,
    href: "https://preview.cloudox.io",
    badge: "Live preview",
    ctaLabel: "Open dashboard",
  },
  {
    title: "Git repository",
    description:
      "Commit reports as plain Markdown. Diff, review, and version discovery documentation like code.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="19" r="2.5"/><path d="M6 8.5v3a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3v-3"/><line x1="12" y1="14.5" x2="12" y2="16.5"/></svg>`,
    href: "https://github.com/cloudox-ai/cloudox-public-examples",
    badge: "Live example",
    ctaLabel: "View example on GitHub",
  },
  {
    title: "Confluence",
    description:
      "Publish reports into Confluence spaces and pages alongside the rest of your team documentation.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16a4 4 0 0 0 4 4h3l3-4-3-4H7a4 4 0 0 0-4 4z"/><path d="M21 8a4 4 0 0 0-4-4h-3l-3 4 3 4h3a4 4 0 0 0 4-4z"/></svg>`,
    badge: "Planned",
    badgeVariant: "muted" as const,
  },
  {
    title: "Notion",
    description:
      "Push reports into a Notion workspace as native pages, organised by account and environment.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6H6a2 2 0 0 0-2 2z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>`,
    badge: "Planned",
    badgeVariant: "muted" as const,
  },
];
---

<BaseLayout
  title="Intelligent Cloud Knowledge Platform"
  description="CloudoX is an intelligent cloud knowledge platform — evidence-based, multi-account, multi-region AWS discovery that builds a typed knowledge graph and makes it readable as documentation, diagrams, and a dashboard."
  jsonLd={[breadcrumb]}
>
  <Hero
    eyebrow="PRODUCT"
    title="A cloud knowledge platform for the people who run cloud."
    subtitle="CloudoX collects AWS-native data, builds a typed knowledge graph, interprets it, and makes that understanding readable — as documentation a human would trust, diagrams, and a dashboard."
    primaryCta={{ label: "Request Early Access", href: "/contact" }}
    secondaryCta={{ label: "Book a call", href: SITE.bookingUrl }}
  />

  <Section
    eyebrow="CAPABILITIES"
    title="What CloudoX does today."
    subtitle="Discovery, a knowledge graph, interpretation, documentation, diagrams, and a dashboard — built on one evidence-grounded foundation."
  >
    <FeatureGrid features={features} cols={3} />
  </Section>

  <Section
    eyebrow="BEYOND THE FIRST REPORT"
    title="The knowledge graph keeps paying off."
    subtitle="Because everything reads from one evidence-grounded graph, CloudoX can answer more than 'what exists?' over time. Two early consumption layers are live today — each deterministic first, AI narration second."
    muted
  >
    <FeatureGrid features={beyond} cols={2} />
  </Section>

  <Section
    eyebrow="WHERE REPORTS LIVE"
    title="Reports where your team already works."
    subtitle="CloudoX writes clean Markdown, so the same report can live in a hosted dashboard, your Git repository, or the documentation tool your team already uses. Two destinations are live today; more are on the roadmap."
    muted
  >
    <FeatureGrid features={reportingTargets} cols={4} />
  </Section>

  <Section
    eyebrow="WHAT CLOUDOX IS NOT"
    title="A focused platform — clear about its boundaries."
  >
    <div class="grid md:grid-cols-3 gap-5">
      <div class="surface p-6">
        <h3 class="text-base font-semibold mb-2">Not a CMDB</h3>
        <p class="text-sm muted">
          Not a system of record for every IT asset. CloudoX builds evidence-grounded
          understanding of how an environment actually works.
        </p>
      </div>
      <div class="surface p-6">
        <h3 class="text-base font-semibold mb-2">Not a security scanner</h3>
        <p class="text-sm muted">
          Findings cover architectural exposure and obvious gaps — not vulnerability or compliance scanning.
        </p>
      </div>
      <div class="surface p-6">
        <h3 class="text-base font-semibold mb-2">Not a diagram-only tool</h3>
        <p class="text-sm muted">
          CloudoX generates architecture diagrams, but they support the
          understanding — the knowledge graph and documentation come first.
        </p>
      </div>
    </div>
  </Section>

  <CTA
    title="See CloudoX on a real environment."
    primary={{ label: "Request Early Access", href: "/contact" }}
    secondary={{ label: "Book a call", href: SITE.bookingUrl }}
  />
</BaseLayout>
