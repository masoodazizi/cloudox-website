---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import { SITE } from "@/config/site";

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home",         item: SITE.url },
    { "@type": "ListItem", position: 2, name: "How It Works", item: `${SITE.url}/how-it-works/` },
  ],
};

const flow = [
  {
    step: "01",
    title: "Connect",
    description:
      "Read-only access to an AWS Organization, account set, or single account. Nothing is created or modified.",
  },
  {
    step: "02",
    title: "Discover",
    description:
      "Modular collectors fan out across accounts and regions, gathering metadata from AWS-native sources — Config, Organizations, Resource Explorer, service APIs, and tags.",
  },
  {
    step: "03",
    title: "Build the knowledge graph",
    description:
      "Raw data is normalized into a typed knowledge graph: accounts, regions, environments, workloads, systems, resources, and explicit, evidence-bearing relationships.",
  },
  {
    step: "04",
    title: "Interpret",
    description:
      "Deterministic logic classifies environments, groups workloads, and detects exposure, then captures the meaning once per domain — the reusable interpretation every channel reads.",
  },
  {
    step: "05",
    title: "Generate intelligence",
    description:
      "Ranked, evidence-grounded findings, risks, and opportunities are derived across architecture, operations, security, cost, and change — once, for every audience to draw from.",
  },
  {
    step: "06",
    title: "Project & narrate",
    description:
      "The understanding is projected into audience-specific Knowledge Views and narrated in plain language — grounded in a closed, citeable context, never invented.",
  },
];

const outputs = [
  {
    title: "Audience-specific understanding",
    description:
      "Executive, Architect, Operations, Security, FinOps, and Generic views — each answering the questions its audience actually asks.",
  },
  {
    title: "Architecture diagrams",
    description:
      "Account structure, workload architecture, and network topology, generated deterministically from the knowledge graph and embedded where they help.",
  },
  {
    title: "Quality you can check",
    description:
      "Every view is scored on usefulness — coverage, signal-to-noise, actionability, prioritization — so you know where it's strong before you share it.",
  },
];
---

<BaseLayout
  title="How CloudoX Works — From AWS APIs to Audience-Specific Understanding"
  description="CloudoX collects AWS-native data, builds a typed knowledge graph, interprets it deterministically, generates ranked intelligence, and projects audience-specific Knowledge Views narrated in plain language — without inventing anything."
  jsonLd={[breadcrumb]}
>
  <Hero
    eyebrow="HOW IT WORKS"
    title="From AWS APIs to understanding — without inventing anything."
    subtitle="A strict pipeline: discover, model, interpret, generate intelligence, project, and narrate. Deterministic analysis decides the facts and the meaning. AI only narrates — it never fabricates."
    primaryCta={{ label: "Request Early Access", href: "/contact" }}
    secondaryCta={{ label: "See the docs", href: "/docs" }}
  />

  <Section eyebrow="WORKFLOW" title="The pipeline.">
    <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {flow.map((s) => (
        <li class="surface p-5">
          <span
            class="inline-flex h-8 w-8 items-center justify-center rounded-md font-mono text-xs mb-3"
            style="background: color-mix(in oklab, var(--accent) 12%, transparent); color: var(--accent);"
          >
            {s.step}
          </span>
          <h3 class="text-sm font-semibold mb-2">{s.title}</h3>
          <p class="text-xs muted leading-relaxed">{s.description}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section
    eyebrow="WHY THE DISCIPLINE MATTERS"
    title="The model never sees raw cloud data."
    subtitle="Every AI-assisted experience follows the same rule: deterministic analysis, then interpretation, then projection, and only then narration. No capability sends raw infrastructure data straight to a model."
    muted
  >
    <p class="text-sm muted max-w-2xl leading-relaxed">
      The knowledge graph holds the facts. The interpretation layer holds the
      meaning. AI is given a closed, citeable context and asked to explain it —
      anything outside that context is rejected before it reaches the page. That's
      what keeps the output something a consultant can sign their name to.
    </p>
  </Section>

  <Section
    eyebrow="OUTPUT"
    title="What you get."
    subtitle="Not a fixed eight-file report — audience-specific understanding you can read, share, and trust."
  >
    <div class="grid gap-5 md:grid-cols-3">
      {outputs.map((o) => (
        <div class="surface p-6">
          <h3 class="text-base font-semibold mb-2">{o.title}</h3>
          <p class="text-sm muted leading-relaxed">{o.description}</p>
        </div>
      ))}
    </div>
    <div class="mt-10 max-w-2xl">
      <p class="text-sm muted leading-relaxed">
        A sanitised example is published publicly so you can read the exact
        structure, tone, and level of detail CloudoX produces.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href="https://preview.cloudox.io"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          Open dashboard preview
        </a>
        <a
          href="https://github.com/cloudox-ai/cloudox-public-examples"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >
          View example on GitHub
        </a>
      </div>
    </div>
  </Section>

  <CTA
    title="Ready to see CloudoX in action?"
    primary={{ label: "Request Early Access", href: "/contact" }}
    secondary={{ label: "Book a call", href: SITE.bookingUrl }}
  />
</BaseLayout>
