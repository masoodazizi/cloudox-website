---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import CodeBlock from "@components/CodeBlock.astro";
import CTA from "@components/CTA.astro";
import { SITE } from "@/config/site";

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home",         item: SITE.url },
    { "@type": "ListItem", position: 2, name: "How It Works", item: `${SITE.url}/how-it-works/` },
  ],
};

const flow = [
  {
    step: "01",
    title: "Connect",
    description:
      "Read-only access to an AWS Organization, account set, or single account. Nothing is created or modified.",
  },
  {
    step: "02",
    title: "Collect",
    description:
      "Modular collectors fan out across accounts and regions, gathering metadata from AWS-native sources (Config, Organizations, Resource Explorer, service APIs, tags).",
  },
  {
    step: "03",
    title: "Model",
    description:
      "Raw data is normalized into a typed knowledge graph: accounts, regions, environments, workloads, systems, resources, and explicit relationships.",
  },
  {
    step: "04",
    title: "Interpret",
    description:
      "Deterministic rules classify environments, group workloads, and surface internet exposure. AI assists with summarization — never invention.",
  },
  {
    step: "05",
    title: "Report",
    description:
      "A clean Markdown discovery report with a predictable structure — easy to commit, share, and review.",
  },
];

const reportStructure = `aws-discovery-report/
├── README.md
├── 01-executive-summary.md
├── 02-architecture-overview.md
├── 03-environment-structure.md
├── 04-networking.md
├── 05-security-overview.md
├── 06-observability.md
├── 07-findings-and-risks.md
└── 08-assumptions-and-unknowns.md`;
---

<BaseLayout
  title="How CloudoX Works — From AWS APIs to a Discovery Report"
  description="CloudoX collects AWS-native data, builds a typed knowledge graph, interprets deterministically, and generates a Markdown discovery report in minutes."
  jsonLd={[breadcrumb]}
>
  <Hero
    eyebrow="HOW IT WORKS"
    title="From AWS APIs to a discovery report — without inventing anything."
    subtitle="A strict pipeline: collect, model, interpret, report. AI helps with summarization. It never fabricates facts."
    primaryCta={{ label: "Request Early Access", href: "/contact" }}
    secondaryCta={{ label: "See the docs", href: "/docs" }}
  />

  <Section eyebrow="WORKFLOW" title="The five steps.">
    <ol class="grid gap-4 md:grid-cols-5">
      {flow.map((s) => (
        <li class="surface p-5">
          <span
            class="inline-flex h-8 w-8 items-center justify-center rounded-md font-mono text-xs mb-3"
            style="background: color-mix(in oklab, var(--accent) 12%, transparent); color: var(--accent);"
          >
            {s.step}
          </span>
          <h3 class="text-sm font-semibold mb-2">{s.title}</h3>
          <p class="text-xs muted leading-relaxed">{s.description}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section
    eyebrow="OUTPUT"
    title="A predictable report structure."
    subtitle="Same sections every time — reviewers know where to find what they need."
    muted
  >
    <div class="max-w-2xl">
      <CodeBlock title="aws-discovery-report/" language="markdown" code={reportStructure} />
      <p class="mt-6 text-sm muted leading-relaxed">
        A sanitised example report is published publicly so you can read the
        exact structure, tone, and level of detail CloudoX produces.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href="https://preview.cloudox.io"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          Open dashboard preview
        </a>
        <a
          href="https://github.com/masoodazizi/cloudox-example-report"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >
          View example on GitHub
        </a>
      </div>
    </div>
  </Section>

  <CTA
    title="Ready to see CloudoX in action?"
    primary={{ label: "Request Early Access", href: "/contact" }}
    secondary={{ label: "Book a call", href: SITE.bookingUrl }}
  />
</BaseLayout>
