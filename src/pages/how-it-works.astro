---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import { SITE } from "@/config/site";
import { EXAMPLE } from "@/config/example";

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home",         item: SITE.url },
    { "@type": "ListItem", position: 2, name: "How It Works", item: `${SITE.url}/how-it-works/` },
  ],
};

/**
 * Each stage states what goes in, what comes out, and what happens when the
 * evidence is incomplete — because the third one is where tools normally
 * start guessing, and it is the part a reader needs to be able to check.
 */
const flow = [
  {
    step: "01",
    title: "Connect",
    input: "A read-only IAM role in an AWS Organization, an account set, or one account.",
    output: "A verified connection scoped to describe/list permissions.",
    gap: "An account that cannot be assumed is reported as failed, not skipped silently.",
  },
  {
    step: "02",
    title: "Discover",
    input: "AWS-native sources only — Organizations, Config, Resource Explorer, service APIs, tags.",
    output: "Raw provider responses, persisted per account and region.",
    gap: "A collector that is denied or unavailable is recorded, and the counts it feeds are published as lower bounds.",
  },
  {
    step: "03",
    title: "Model",
    input: "Those raw responses.",
    output:
      "A typed knowledge graph: accounts, regions, resources, and explicit relationships, each carrying the field it was derived from.",
    gap: "A relationship with no supporting field is not created. There is no inferred edge without evidence.",
  },
  {
    step: "04",
    title: "Interpret",
    input: "The graph, and nothing else.",
    output:
      "Deterministic meaning — environment classification, workload grouping, internet exposure — written once per domain and reused everywhere.",
    gap: "Weak signal produces a lower confidence label, or `Unknown`. It never produces a confident guess.",
  },
  {
    step: "05",
    title: "Rank",
    input: "The interpreted domains.",
    output:
      "One significance-ranked set of findings, risks, opportunities, and open questions — generated once, not per audience.",
    gap: "Missing evidence becomes a first-class item of its own, so a gap is surfaced instead of absorbed.",
  },
  {
    step: "06",
    title: "Project & narrate",
    input: "The ranked set, projected into each audience lens.",
    output:
      "Audience views in plain language, with diagrams built deterministically from the graph.",
    gap:
      "Narration is checked against the citeable context it was given; anything outside it is rejected and the deterministic text is published instead.",
  },
];

const outputs = [
  {
    title: "Audience-specific understanding",
    description:
      "Executive, Architect, Operations, Security, FinOps, and Generic views — each answering the questions its audience actually asks.",
  },
  {
    title: "Architecture diagrams",
    description:
      "Account structure, workload architecture, and network topology, generated deterministically from the knowledge graph and embedded where they help.",
  },
  {
    title: "Reference tables",
    description:
      "Routing, connectivity, ingress, identity and trust, dependencies, encryption, and tagging coverage — each row citing the resource it came from.",
  },
  {
    title: "A quality score on itself",
    description:
      "Every view is scored deterministically on coverage, signal-to-noise, actionability, and prioritization, so you can see where the output is weak before you share it.",
  },
];
---

<BaseLayout
  title="How CloudoX Works — From AWS APIs to Audience-Specific Understanding"
  description="CloudoX collects AWS-native data, builds a typed knowledge graph, interprets it deterministically, generates ranked intelligence, and projects audience-specific Knowledge Views narrated in plain language — without inventing anything."
  jsonLd={[breadcrumb]}
>
  <Hero
    eyebrow="HOW IT WORKS"
    title="Six stages. Only the last one involves a model."
    subtitle="Facts are collected from AWS-native sources and meaning is derived deterministically, before any narration happens. This page shows what each stage produces — and what it does when the evidence is not there."
    primaryCta={{ label: "Request early access", href: "/contact" }}
    secondaryCta={{ label: "Read the docs", href: "/docs" }}
  />

  <Section
    eyebrow="THE PIPELINE"
    title="Six stages, and what each one refuses to do."
    subtitle="Stages 01 to 05 contain no AI at all. The same graph produces the same interpretation every time it is run."
  >
    <ol class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {flow.map((s) => (
        <li class="surface flex flex-col p-5">
          <div class="flex items-center gap-3">
            <span
              class="inline-flex h-8 w-8 items-center justify-center rounded-md font-mono text-xs"
              style="background: color-mix(in oklab, var(--accent) 12%, transparent); color: var(--accent);"
            >
              {s.step}
            </span>
            <h3 class="text-sm font-semibold">{s.title}</h3>
          </div>
          <dl class="mt-4 space-y-2.5 text-xs leading-relaxed">
            <div>
              <dt class="uppercase tracking-wide muted">In</dt>
              <dd class="mt-0.5 muted">{s.input}</dd>
            </div>
            <div>
              <dt class="uppercase tracking-wide muted">Out</dt>
              <dd class="mt-0.5">{s.output}</dd>
            </div>
            <div class="pt-2.5" style="border-top: 1px solid var(--border);">
              <dt class="uppercase tracking-wide" style="color: var(--accent);">
                If evidence is missing
              </dt>
              <dd class="mt-0.5 muted">{s.gap}</dd>
            </div>
          </dl>
        </li>
      ))}
    </ol>
  </Section>

  <Section
    eyebrow="THE AI BOUNDARY"
    title="Stage 06 is the only stage a model touches."
    subtitle="It receives the interpreted, bounded context for one section — summaries, ranked items, entity names, evidence references. Not the graph, not raw provider responses, not your account data."
    muted
  >
    <div class="max-w-2xl">
      <p class="text-sm muted leading-relaxed">
        Because the context is a closed set, every citation can be checked
        against it. A narration that references something outside that set is
        rejected and the deterministic text is published in its place — so the
        worst case is plainer prose, not a confident invention. The facts and
        their meaning are already fixed by then; the model changes how they read,
        never what they say.
      </p>
      <p class="mt-4 text-sm">
        <a href="/security" class="font-medium" style="color: var(--accent);">
          How access, data handling, and the AI boundary work →
        </a>
      </p>
    </div>
  </Section>

  <Section
    eyebrow="OUTPUT"
    title="What a run leaves behind."
    subtitle="Readable pages, not a data export you still have to interpret. Everything below is generated from the same graph, so the numbers agree across them."
  >
    <div class="grid gap-5 md:grid-cols-2">
      {outputs.map((o) => (
        <div class="surface p-6">
          <h3 class="text-base font-semibold mb-2">{o.title}</h3>
          <p class="text-sm muted leading-relaxed">{o.description}</p>
        </div>
      ))}
    </div>
    <div class="mt-10 max-w-2xl">
      <p class="text-sm muted leading-relaxed">
        The output of a real run is published, sanitized, so you can read the
        exact structure, tone, and level of detail — including where it says it
        could not tell.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={EXAMPLE.previewUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          Explore the real example
        </a>
        <a
          href={EXAMPLE.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >
          Read it as Markdown on GitHub
        </a>
      </div>
    </div>
  </Section>

  <CTA
    title="Run this pipeline against your own environment."
    primary={{ label: "Request early access", href: "/contact" }}
    secondary={{ label: "Book a call", href: SITE.bookingUrl }}
  />
</BaseLayout>
