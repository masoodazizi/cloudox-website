---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { SITE } from "@/config/site";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const docs = await getCollection("docs", ({ data }) => !data.draft);
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
};

const { doc } = Astro.props as {
  doc: Awaited<ReturnType<typeof getCollection<"docs">>>[number];
};
const { Content } = await render(doc);

const allDocs = await getCollection("docs", ({ data }) => !data.draft);
const grouped = allDocs.reduce((acc, d) => {
  const section = d.data.section ?? "Guides";
  (acc[section] ??= []).push(d);
  return acc;
}, {} as Record<string, typeof allDocs>);

const sectionOrder = ["Getting Started", "Concepts", "Guides", "Reference"];
const sections = Object.keys(grouped).sort((a, b) => {
  const ai = sectionOrder.indexOf(a);
  const bi = sectionOrder.indexOf(b);
  if (ai === -1 && bi === -1) return a.localeCompare(b);
  if (ai === -1) return 1;
  if (bi === -1) return -1;
  return ai - bi;
});
for (const key of Object.keys(grouped)) {
  grouped[key].sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100));
}

const pageUrl = `${SITE.url}/docs/${doc.id}/`;

// BreadcrumbList — present on every doc page.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home",       item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Docs",       item: `${SITE.url}/docs/` },
    { "@type": "ListItem", position: 3, name: doc.data.title, item: pageUrl },
  ],
};

// FAQPage — only for the FAQ doc; extracts h2 + following paragraphs via headings.
// We hard-code the Q&A pairs here because the rendered Markdown is the canonical
// source and the JSON-LD needs clean plain text.
const faqSchema =
  doc.id === "07-faq"
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: [
          {
            "@type": "Question",
            name: "Does CloudoX modify anything in my AWS environment?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "No, and it can't. CloudoX only calls describe and list operations. The permissions it needs are declared in one place in the codebase, and an automated test walks every collector on each commit — failing the build if anything creates, modifies, or deletes. Read-only is enforced by the build rather than promised in a document.",
            },
          },
          {
            "@type": "Question",
            name: "What exactly can CloudoX read in my account?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Configuration metadata: how resources are set up, how the network is put together, how access is structured, resource tags, and account and region structure. Not the contents of your systems — no objects or files, no secrets or environment variables, no database rows, no logs. The access it asks for is generated from its own collector code, so you can print the exact permission set before granting anything. It excludes data-plane reads, and also excludes EC2 user data and Lambda environment variables, which broad AWS-managed audit policies would grant and which commonly carry credentials.",
            },
          },
          {
            "@type": "Question",
            name: "Do I have to grant CloudoX access to my account at all?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "No. CloudoX runs as a command-line tool inside your own environment, with your own credentials, writing to your own storage — no CloudoX account and no cross-account role. If you would rather evaluate it without granting a vendor anything, that is the supported way to do it.",
            },
          },
          {
            "@type": "Question",
            name: "Does my infrastructure data get sent to an LLM?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Only a bounded summary of already-interpreted knowledge, and only if you want narration. Discovery and analysis are deterministic and involve no model at all; raw provider data, the full knowledge graph, and billing records never reach one. You can turn narration off completely and still get a full report, or run narration through Amazon Bedrock in your own AWS account.",
            },
          },
          {
            "@type": "Question",
            name: "Can't we just build this ourselves with an LLM and a script?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "You can build the first version in an afternoon, and it will look convincing. The gap shows up in three places. A model reading raw API output infers relationships from names and adjacency, so it asserts links that don't exist and misses ones that do — CloudoX derives relationships deterministically from provider evidence, and each one carries that evidence. Prompt-driven analysis isn't reproducible, whereas CloudoX's analysis is deterministic and content-hashed, which is what makes comparing two discovery runs meaningful. And CloudoX rejects statements citing anything outside the evidence it was given, validates the finished report, and scores whether each audience view answered its audience's questions. Then there is the part nobody budgets for: keeping collectors correct across dozens of services as provider APIs drift, forever.",
            },
          },
          {
            "@type": "Question",
            name: "Does CloudoX support AWS Organizations and multiple accounts?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Yes. CloudoX is designed for multi-account AWS Organizations environments and tracks workloads, networking, and dependencies across accounts.",
            },
          },
          {
            "@type": "Question",
            name: "Does CloudoX support multiple regions?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Yes. Resources, networking, and dependencies are tracked per region.",
            },
          },
          {
            "@type": "Question",
            name: "Does CloudoX use AI?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "CloudoX is AI-assisted, not AI-invented. Deterministic analysis decides the facts and the meaning; AI narrates that interpreted knowledge in plain language. AI does not invent ownership, environments, or architecture, and the model never sees raw cloud data — only a closed, citeable context.",
            },
          },
          {
            "@type": "Question",
            name: "What are Knowledge Views?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Knowledge Views are audience lenses over the same interpreted knowledge — Generic, Executive, Architect, Operations, Security, and FinOps. Each one frames the understanding a specific stakeholder needs. Different audiences get different explanations and priorities, never different truths.",
            },
          },
          {
            "@type": "Question",
            name: "What does the output look like?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Audience-specific, AI-narrated understanding in clean Markdown — one page per Knowledge View — plus architecture diagrams generated from the knowledge graph. You can read it in a hosted dashboard, commit it to Git, or browse the sanitised public example.",
            },
          },
          {
            "@type": "Question",
            name: "Can I keep my report?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Yes. Reports are plain Markdown files. You can commit them to a repo, drop them into Confluence, or share them as you would any document.",
            },
          },
          {
            "@type": "Question",
            name: "Will CloudoX support Azure or GCP?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Azure and GCP are part of the roadmap. The architecture is designed to be multi-cloud.",
            },
          },
          {
            "@type": "Question",
            name: "Is CloudoX a CMDB or security scanner?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "No. CloudoX is an intelligent cloud knowledge platform — it discovers, interprets, and explains cloud environments. It is intentionally not a CMDB, vulnerability scanner, compliance product, or FinOps platform.",
            },
          },
          {
            "@type": "Question",
            name: "Is CloudoX only a documentation tool?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "No. A report is one way to read the knowledge CloudoX builds — not the product. The core is an evidence-grounded knowledge graph and its interpretation; Knowledge Views, AI-narrated reports, architecture diagrams, and a hosted dashboard are all lenses on top of it. Environment Evolution and Cost Intelligence ship as first versions today.",
            },
          },
          {
            "@type": "Question",
            name: "Where does the name CloudoX come from?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "It started as a play on Cloud Documentation: Cloud Documentation to Cloud Docs to Cloudocs to CloudoX. The capital X keeps the nod to documentation while signalling discovery and exploration — 'X marks the spot' for mapping unfamiliar cloud territory. The product has since grown into a cloud knowledge platform, but the name kept its roots.",
            },
          },
          {
            "@type": "Question",
            name: "How do I get access?",
            acceptedAnswer: {
              "@type": "Answer",
              text: "Request early access at cloudox.io/contact — we're working hands-on with a small group of consultants and engineers to shape the platform.",
            },
          },
        ],
      }
    : null;

const jsonLd = faqSchema ? [breadcrumbSchema, faqSchema] : [breadcrumbSchema];
---

<BaseLayout title={doc.data.title} description={doc.data.description} jsonLd={jsonLd}>
  <div class="container-page py-12 md:py-16 grid md:grid-cols-12 gap-10">
    <aside class="md:col-span-3 md:sticky md:top-20 md:self-start">
      <nav aria-label="Docs navigation" class="space-y-6 text-sm">
        {sections.map((section) => (
          <div>
            <p class="text-xs uppercase tracking-[0.14em] mb-2" style="color: var(--accent);">{section}</p>
            <ul class="space-y-1">
              {grouped[section].map((d) => (
                <li>
                  <a
                    href={`/docs/${d.id}`}
                    class="block py-1"
                    aria-current={d.id === doc.id ? "page" : undefined}
                    style={`color: ${d.id === doc.id ? "var(--fg)" : "var(--fg-muted)"}; ${d.id === doc.id ? "font-weight: 600;" : ""}`}
                  >
                    {d.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <article class="md:col-span-9 prose-cloudox max-w-none">
      <p class="eyebrow mb-3">{doc.data.section}</p>
      <h1 class="text-3xl md:text-4xl font-semibold tracking-tight mb-3">{doc.data.title}</h1>
      <p class="text-base muted mb-8">{doc.data.description}</p>
      <hr />
      <Content />
    </article>
  </div>
</BaseLayout>
