---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import { SITE } from "@/config/site";

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home",            item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Knowledge Views", item: `${SITE.url}/knowledge-views/` },
  ],
};

const views = [
  {
    name: "Executive",
    audience: "CTOs & engineering leadership",
    purpose:
      "Risk, decisions, and cost at a glance — understanding and decisions first, inventory never.",
    questions: [
      "What requires leadership attention?",
      "What are the highest risks?",
      "What decisions are needed?",
    ],
  },
  {
    name: "Architect",
    audience: "Solutions & cloud architects",
    purpose:
      "Architecture, workloads, dependencies, networking, and the design risks worth acting on.",
    questions: [
      "What design issues exist?",
      "Which dependencies matter?",
      "What modernization opportunities exist?",
    ],
  },
  {
    name: "Operations",
    audience: "Platform & operations engineers",
    purpose:
      "Operational documentation: connectivity, routing, observability, backup, and recovery readiness.",
    questions: [
      "What can break?",
      "What needs operational attention?",
      "What recovery risks exist?",
    ],
  },
  {
    name: "Security",
    audience: "Security & governance teams",
    purpose:
      "Exposure, identity, governance, and the evidence gaps that hide risk.",
    questions: [
      "What is exposed, and to whom?",
      "Where is access over-privileged or unclear?",
      "What governance or evidence gaps exist?",
    ],
  },
  {
    name: "FinOps",
    audience: "FinOps & finance",
    purpose:
      "Cost drivers and optimization opportunities connected to the workloads that cause them.",
    questions: [
      "What is driving cost?",
      "Where is the waste?",
      "What optimization is worth validating?",
    ],
  },
  {
    name: "Generic",
    audience: "Any technical reader",
    purpose:
      "A balanced, full-depth understanding of the environment. The default when no audience is selected.",
    questions: [
      "What exists, and how does it work?",
      "What matters most right now?",
      "What is uncertain?",
    ],
  },
];

const principles = [
  {
    title: "One source of truth",
    description:
      "Every view reads the same knowledge graph and the same interpretation. A view curates and frames — it never re-derives or contradicts the facts.",
  },
  {
    title: "Different lenses, never different truths",
    description:
      "Audiences get different explanations, priorities, and depth. If two views disagreed on a fact, that would be a bug — the underlying interpretation is singular.",
  },
  {
    title: "Friendly names, traceable evidence",
    description:
      "Views lead with human names (Production Account, Production VPC) and a clear confidence label, while every reference still traces back to its raw identifier.",
  },
  {
    title: "AI-narrated, evidence-grounded",
    description:
      "Each view is narrated in plain language from interpreted knowledge — the model is given a closed, citeable context and may not invent anything outside it.",
  },
];
---

<BaseLayout
  title="Knowledge Views — Audience-Specific Cloud Understanding"
  description="CloudoX Knowledge Views project one evidence-grounded knowledge graph into audience-specific understanding for executives, architects, operations, security, and FinOps — different explanations and priorities, never different truths."
  jsonLd={[breadcrumb]}
>
  <Hero
    eyebrow="KNOWLEDGE VIEWS"
    title="The same environment, explained for whoever is reading."
    subtitle="A Knowledge View is an audience lens over one interpreted knowledge foundation. Each view selects, prioritizes, and frames the understanding a specific stakeholder needs — narrated in plain language and grounded in evidence."
    primaryCta={{ label: "Request Early Access", href: "/contact" }}
    secondaryCta={{ label: "Book a call", href: SITE.bookingUrl }}
  />

  <Section
    eyebrow="THE VIEWS"
    title="Six lenses on one truth."
    subtitle="Each view answers the strategic questions its audience actually asks. The set is extensible — a new audience is a new lens, not a new discovery."
  >
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {views.map((v) => (
        <article class="surface flex flex-col p-6">
          <p class="eyebrow mb-2">{v.audience}</p>
          <h3 class="text-lg font-semibold mb-2">{v.name} View</h3>
          <p class="text-sm muted leading-relaxed mb-4">{v.purpose}</p>
          <ul class="mt-auto space-y-1.5 text-sm muted">
            {v.questions.map((q) => (
              <li class="flex gap-2">
                <span aria-hidden="true" style="color: var(--accent);">›</span>
                <span>{q}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </Section>

  <Section
    eyebrow="HOW VIEWS STAY HONEST"
    title="Many lenses, one source of meaning."
    subtitle="Knowledge Views are projections over the Canonical Interpretation Layer — the reusable meaning CloudoX derives once from the knowledge graph. They share names, confidence, and evidence so audiences never drift apart."
    muted
  >
    <div class="grid gap-5 sm:grid-cols-2">
      {principles.map((p) => (
        <div class="surface p-6">
          <h3 class="text-base font-semibold mb-2">{p.title}</h3>
          <p class="text-sm muted leading-relaxed">{p.description}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section
    eyebrow="CHANGE AND COST, IN CONTEXT"
    title="Understanding that stays current."
  >
    <div class="grid gap-5 md:grid-cols-2">
      <div class="surface p-6">
        <h3 class="text-base font-semibold mb-2">Evolution inside the view</h3>
        <p class="text-sm muted leading-relaxed">
          Views are built to show current state alongside what changed since the
          previous discovery — new workloads, removed infrastructure, an exposure
          that opened — so change becomes part of everyday understanding instead
          of a separate report.
        </p>
      </div>
      <div class="surface p-6">
        <h3 class="text-base font-semibold mb-2">Cost where it belongs</h3>
        <p class="text-sm muted leading-relaxed">
          Cost appears inside the FinOps and Architect views, connected to the
          workloads and architectural decisions that drive it — never a detached
          billing page, and never a replacement for Cost Explorer or FinOps tools.
        </p>
      </div>
    </div>
  </Section>

  <Section
    eyebrow="KNOWLEDGE QUALITY"
    title="Scored on usefulness, not just correctness."
    subtitle="A grounded report can still be useless to a CTO. CloudoX measures whether each view actually answers its audience's questions — coverage, signal-to-noise, actionability, and prioritization — so quality is about usefulness, not only accuracy."
    muted
  >
    <p class="text-sm muted max-w-2xl leading-relaxed">
      Knowledge Quality runs as a deterministic check over every view, with an
      optional AI quality review on top. It never changes the facts and never
      invents intelligence — it tells you where a view is thin, noisy, or missing
      something its audience needs.
    </p>
  </Section>

  <CTA
    title="See your environment through every lens."
    primary={{ label: "Request Early Access", href: "/contact" }}
    secondary={{ label: "Book a call", href: SITE.bookingUrl }}
  />
</BaseLayout>
