---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { SITE } from "@/config/site";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props as {
  post: Awaited<ReturnType<typeof getCollection<"blog">>>[number];
};
const { Content } = await render(post);

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const wordCount = (post.body ?? "").split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

const postUrl = `${SITE.url}/blog/${post.id}/`;

/**
 * Covers are authored as SVG for the page, but social preview consumers do not
 * render SVG — so the card points at the PNG sibling emitted by
 * `scripts/generate-raster-assets.mjs`.
 */
const socialCard = post.data.cover
  ? post.data.cover.replace(/\.svg$/, ".png")
  : SITE.ogImage;
const coverUrl = new URL(socialCard, SITE.url).toString();

const blogPostSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": postUrl,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate
    ? { dateModified: post.data.updatedDate.toISOString() }
    : {}),
  author: {
    "@type": "Organization",
    "@id": `${SITE.url}/#organization`,
    name: post.data.author ?? SITE.name,
  },
  publisher: { "@id": `${SITE.url}/#organization` },
  image: coverUrl,
  url: postUrl,
  isPartOf: { "@id": `${SITE.url}/#website` },
  keywords: post.data.tags.join(", "),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={socialCard}
  imageAlt={post.data.coverAlt ?? post.data.title}
  ogType="article"
  jsonLd={[blogPostSchema]}
>
  <Fragment slot="head">
    <meta
      property="article:published_time"
      content={post.data.pubDate.toISOString()}
    />
    {post.data.updatedDate && (
      <meta
        property="article:modified_time"
        content={post.data.updatedDate.toISOString()}
      />
    )}
    <meta property="article:author" content={post.data.author ?? SITE.name} />
    {post.data.tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </Fragment>

  <article class="container-narrow py-16 md:py-20 prose-cloudox">
    <p class="eyebrow mb-3">BLOG</p>
    <h1 class="text-3xl md:text-5xl font-semibold tracking-tight mb-4">
      {post.data.title}
    </h1>
    <p class="text-base muted mb-3">{post.data.description}</p>
    <p class="text-sm muted mb-8">
      <time datetime={post.data.pubDate.toISOString()}>
        {formatDate(post.data.pubDate)}
      </time>
      {" "}· {post.data.author}
      {" "}· {readingMinutes} min read
      {post.data.tags.length > 0 && (
        <> · {post.data.tags.join(" · ")}</>
      )}
    </p>

    {post.data.cover && (
      <img
        src={post.data.cover}
        alt={post.data.coverAlt ?? post.data.title}
        width="1200"
        height="630"
        decoding="async"
        class="blog-cover mb-10 aspect-[1200/630] w-full rounded-xl border object-cover"
        style="border-color: var(--border);"
      />
    )}

    <hr />
    <Content />

    <hr class="mt-12" />
    <div class="mt-8 flex justify-between text-sm">
      <a href="/blog" class="muted">← All posts</a>
      <a href="/contact" style="color: var(--accent);">Request early access →</a>
    </div>
  </article>
</BaseLayout>
