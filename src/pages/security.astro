---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import { SITE } from "@/config/site";
import { LEGAL_OPERATOR } from "@/config/legal";

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home",     item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Security", item: `${SITE.url}/security/` },
  ],
};

/**
 * The security questions, in one place. They are both rendered visibly on the
 * page (the one Q&A section below) and emitted as FAQPage structured data —
 * Google requires that FAQ markup represent content the visitor can actually
 * see, so these must never diverge, and there must be exactly one visible
 * rendering of this list on the page (no duplicate section elsewhere).
 */
const questions = [
  {
    question: "Can CloudoX change anything in my AWS account?",
    answer:
      "No. CloudoX only calls describe and list APIs. The permissions it needs are declared in one place in the codebase, and an automated test fails if any collector calls an API that creates, modifies, or deletes anything. Read-only is enforced by the test suite, not promised in a document.",
  },
  {
    question: "Can CloudoX read my data — objects, secrets, database rows, or logs?",
    answer:
      "No. The access CloudoX requests deliberately excludes data-plane reads: S3 object contents, Secrets Manager secret values, SSM parameter values, DynamoDB items, log events, and KMS decryption. It also excludes EC2 user data and Lambda environment variables, which commonly carry secrets and which broad AWS-managed audit policies would have granted.",
  },
  {
    question: "Can the access request quietly grow wider over time?",
    answer:
      "No. The declared permissions are generated from the collector code, and the same test suite fails if they drift wider than the code — if an action is no longer called by any collector, it has to be removed. The grant can only shrink or stay exact; it can never quietly expand beyond what the product actually does.",
  },
  {
    question: "Does my infrastructure data get sent to an LLM?",
    answer:
      "Only a bounded, reduced projection of already-interpreted knowledge, and only if you want narration at all. The analysis stage makes no model calls, and you can produce a complete report with no model call whatsoever.",
  },
];

const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((entry) => ({
    "@type": "Question",
    name: entry.question,
    acceptedAnswer: { "@type": "Answer", text: entry.answer },
  })),
};
---

<BaseLayout
  title="Security — Read-Only by Construction"
  description="CloudoX only describes and lists. The IAM access it requests is generated from its own collector code and excludes all data-plane reads, enforced by an automated test suite. Analysis is deterministic; AI narration is optional and can be turned off entirely."
  jsonLd={[breadcrumb, faq]}
>
  <Hero
    eyebrow="SECURITY"
    title="Read-only by construction — not by promise."
    subtitle="Granting a third party access to your cloud account deserves more than a reassuring sentence. This page explains exactly what CloudoX can do in an AWS account, what it deliberately cannot do, and what a model ever sees."
    primaryCta={{ label: "Talk to us about a security review", href: "/contact" }}
    secondaryCta={{ label: "How it works", href: "/how-it-works" }}
  />

  <Section eyebrow="THE FOUR QUESTIONS" title="Four questions, answered plainly.">
    <p class="text-sm muted max-w-2xl leading-relaxed mb-10">
      "I don't want to give a tool access to my account" is usually four
      questions at once, and answering them as one — "don't worry, it's
      read-only" — answers none of them. So here they are separately. Ask
      for more — we're happy to walk your security team through the exact
      permission set.
    </p>
    <div class="max-w-3xl divide-y" style="border-color: var(--border);">
      {questions.map((entry) => (
        <div class="py-6 first:pt-0">
          <h3 class="text-base font-semibold mb-2">{entry.question}</h3>
          <p class="text-sm muted leading-relaxed">{entry.answer}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section
    eyebrow="WHAT IS COLLECTED"
    title="Configuration metadata — and we'll be specific about it."
  >
    <div class="grid gap-8 md:grid-cols-2 max-w-4xl">
      <div>
        <h3 class="text-sm font-semibold mb-3">Collected</h3>
        <ul class="space-y-2 text-sm muted leading-relaxed">
          <li>Resource configuration as the provider reports it</li>
          <li>Network topology and routing</li>
          <li>Security group and exposure configuration</li>
          <li>IAM roles, policies, and trust structure</li>
          <li>Resource tags</li>
          <li>Organizations, account, and region structure</li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold mb-3">Not collected</h3>
        <ul class="space-y-2 text-sm muted leading-relaxed">
          <li>Object, file, or database contents</li>
          <li>Secrets, parameter values, or environment variables</li>
          <li>Application or access logs</li>
          <li>Application traffic or customer data</li>
          <li>Anything that requires decryption</li>
        </ul>
      </div>
    </div>
    <p class="text-sm muted leading-relaxed max-w-2xl mt-8">
      Being precise cuts both ways, so: configuration metadata is not the same as
      "nothing sensitive". Tags can carry owner names and project codenames, and
      policy documents name principals and accounts. We would rather say that
      than have your security reviewer discover it. For anything you want to
      share more widely, CloudoX can produce a consistently sanitised copy with
      identifiers replaced — that is how our public example report is made.
    </p>
  </Section>

  <Section
    eyebrow="AI"
    title="The model never sees raw cloud data."
    subtitle="Discovery and analysis are deterministic and involve no model at all. AI is a narration layer on top of already-computed structure — and it is optional."
    muted
  >
    <div class="max-w-2xl space-y-4 text-sm muted leading-relaxed">
      <p>
        Facts are established before any model is involved. The knowledge graph
        holds what exists, deterministic interpretation decides what it means,
        and only then is a bounded, citeable summary handed to a model to put
        into words. Raw provider payloads, the full graph, billing records, and
        historical snapshots never reach it.
      </p>
      <p>
        Anything the model cites must already be in the context it was given.
        Citations outside that closed set are rejected before they reach the
        page — which is also why it cannot invent a resource that does not exist
        in your environment.
      </p>
      <p>
        <strong>You can turn narration off entirely.</strong> CloudoX will
        produce a complete report deterministically, with zero model calls.
      </p>
    </div>
  </Section>

  <Section eyebrow="HONESTY" title="Where we're not finished yet — and what we're doing about it." muted>
    <div class="max-w-2xl space-y-4 text-sm muted leading-relaxed">
      <p>
        A security page that lists only strengths is not a security page.
        CloudoX is in early access, so here is exactly where we fall short
        today, and what closes each gap:
      </p>
      <ul class="space-y-2">
        <li>
          No third-party audit, SOC 2 report, or independent penetration test
          yet. We would rather say that than imply otherwise — an audit is on
          our roadmap as the customer base grows, and we'll publish it when
          it happens.
        </li>
        <li>
          In the hosted platform, generated artifacts are isolated per
          customer by access control rather than by a dedicated encryption key
          per customer. That is a deliberate, cost-driven choice today; a
          dedicated-key option is something we can prioritise if you need it.
        </li>
        <li>
          There is no per-field collection opt-out today. If a specific
          configuration field is a problem for you, tell us and we will
          prioritise it — that is exactly the feedback early access is for.
        </li>
      </ul>
      <p>
        If you have a security questionnaire, send it. We would rather answer it
        directly, and work through any gap it surfaces with you, than have you
        guess from a web page.
      </p>
    </div>
  </Section>

  <Section eyebrow="RESPONSIBLE DISCLOSURE" title="Found a security issue? Tell us directly." muted>
    <div class="max-w-2xl space-y-3 text-sm muted leading-relaxed">
      <p>
        Report suspected vulnerabilities in the CloudoX product or this
        website to{" "}
        <a href={`mailto:${LEGAL_OPERATOR.securityEmail}`} class="underline" style="color: var(--accent);">
          {LEGAL_OPERATOR.securityEmail}
        </a>. Please include enough detail to reproduce the issue; we will
        acknowledge reports and follow up directly rather than through a public
        bug bounty program, which we do not currently run.
      </p>
      <p class="text-xs">
        See also <a href="/.well-known/security.txt" class="underline">/.well-known/security.txt</a>.
      </p>
    </div>
  </Section>

  <CTA
    title="Have your security team look at it."
    subtitle="We'll walk through the exact permission set, the data boundary, and how to run it with no model involved at all."
    primary={{ label: "Get in touch", href: "/contact" }}
    secondary={{ label: "Book a call", href: SITE.bookingUrl }}
  />
</BaseLayout>
