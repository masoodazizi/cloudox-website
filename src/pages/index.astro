---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import AudienceViews from "@components/AudienceViews.astro";
import { SITE } from "@/config/site";
import { EXAMPLE } from "@/config/example";

// Three decisions the platform supports, each pointing at something real.
const outcomes = [
  {
    title: "Orient",
    description:
      "Accounts, workloads, and how they connect — derived from provider APIs and tags, not a diagram someone drew last year.",
    proof: "In the example: a landing-zone structure across 7 named accounts, 15 VPCs, 63 subnets.",
    href: "/product",
    linkLabel: "What you receive",
  },
  {
    title: "Explain",
    description:
      "Every finding names the resource it came from and carries a plain confidence label — thin evidence says so, instead of rounding up to certainty.",
    proof: "In the example: 781 of 833 resources carry no environment tag — so classification is labelled inferred.",
    href: "/how-it-works",
    linkLabel: "How that works",
  },
  {
    title: "Track",
    description:
      "Compare two discoveries and read the difference — a region that appeared, an exposure that opened — observed change, kept separate from interpretation.",
    proof: "In the example: one security group became internet-reachable, another stopped being reachable.",
    href: "/use-cases",
    linkLabel: "When this helps",
  },
];

// The trust boundary, stated compactly. Full detail lives on /security.
const boundary = [
  {
    title: "Read-only, enforced by the build",
    description: "A test fails if any collector calls something that creates, modifies, or deletes.",
  },
  {
    title: "No data-plane reads",
    description: "Object contents, secrets, table items, and log events are excluded by name.",
  },
  {
    title: "The model never sees raw cloud data",
    description: "Analysis is deterministic. Narration is optional, and receives a bounded summary.",
  },
  {
    title: "Nothing installed in your account",
    description: "One read-only role from a template you can read first, revocable any time.",
  },
];
---

<BaseLayout
  description="CloudoX turns AWS evidence into an explainable model of workloads, exposure, cost drivers, and change — one focused view per stakeholder, every statement traceable to the resource it came from. Understand any cloud environment in under 30 minutes."
>
  <Hero
    eyebrow="INTELLIGENT CLOUD KNOWLEDGE PLATFORM"
    title="Understand any cloud environment in under 30 minutes."
    subtitle="CloudoX turns AWS evidence into an explainable map of workloads, exposure, cost drivers, and change — with one focused view for each stakeholder."
    primaryCta={{ label: "Explore the real example", href: EXAMPLE.previewUrl }}
    secondaryCta={{ label: "Request early access", href: "/contact" }}
    trustLine="Read-only access. Every finding traced to a resource. Deterministic analysis."
  />

  <Section
    eyebrow="WHAT YOU DO WITH IT"
    title="Orient, explain, track."
    subtitle="Three things a team actually needs from an unfamiliar cloud environment — and what the published example shows for each."
  >
    <div class="grid gap-5 md:grid-cols-3">
      {outcomes.map((outcome, i) => (
        <article class="surface flex flex-col p-6">
          <span
            class="inline-flex h-8 w-8 items-center justify-center rounded-md font-mono text-sm mb-4"
            style="background: color-mix(in oklab, var(--accent) 12%, transparent); color: var(--accent);"
            aria-hidden="true"
          >
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="text-lg font-semibold mb-2.5">{outcome.title}</h3>
          <p class="text-sm muted leading-relaxed">{outcome.description}</p>
          <p
            class="mt-4 pt-4 text-xs muted leading-relaxed"
            style="border-top: 1px solid var(--border);"
          >
            {outcome.proof}
          </p>
          <a
            href={outcome.href}
            class="mt-4 text-sm font-medium"
            style="color: var(--accent);"
          >
            {outcome.linkLabel} →
          </a>
        </article>
      ))}
    </div>
  </Section>

  <Section
    eyebrow="KNOWLEDGE VIEWS"
    title="One environment. Six ways to read it."
    subtitle="An executive, an architect, and a security reviewer need different explanations of the same cloud — never different truths. Below is what each view leads with in the published example."
    muted
  >
    <AudienceViews />
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={EXAMPLE.previewUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        Open the example dashboard
      </a>
      <a href="/product#knowledge-views" class="btn btn-secondary">
        How views are built
      </a>
    </div>
  </Section>

  <Section eyebrow="THE BOUNDARY" title="What CloudoX can and cannot touch." muted>
    <div class="grid gap-5 sm:grid-cols-2">
      {boundary.map((item) => (
        <div class="surface p-6">
          <h3 class="text-base font-semibold mb-2">{item.title}</h3>
          <p class="text-sm muted leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
    <div class="mt-8">
      <a href="/security" class="btn btn-secondary">
        The exact permissions, and what we can't claim yet
      </a>
    </div>
  </Section>

  <CTA
    title="Bring us an environment you don't fully understand."
    subtitle="Early access is for cloud consultants, architects, and engineers working in real, messy AWS estates. Tell us about yours and we'll show you what CloudoX makes of it."
    primary={{ label: "Request early access", href: "/contact" }}
    secondary={{ label: "Book a 30-min walkthrough", href: SITE.bookingUrl }}
  />
</BaseLayout>
