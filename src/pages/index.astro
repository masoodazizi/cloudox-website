---
import BaseLayout from "@layouts/BaseLayout.astro";
import EarlyAccessForm from "@components/EarlyAccessForm.astro";
import KnowledgeConstellation from "@components/KnowledgeConstellation.astro";
import ProductShowcase from "@components/ProductShowcase.astro";
import "@/styles/constellation-hero.css";
import "@/styles/home-sections.css";
import Section from "@components/Section.astro";
import CTA from "@components/CTA.astro";
import AudienceViews from "@components/AudienceViews.astro";
import { SITE } from "@/config/site";

// The trust boundary, stated compactly. Full detail lives on /security.
const boundary = [
  {
    title: "Read-only, enforced by the build",
    description: "A test fails if any collector calls something that creates, modifies, or deletes.",
  },
  {
    title: "No data-plane reads",
    description: "Object contents, secrets, table items, and log events are excluded by name.",
  },
  {
    title: "The model never sees raw cloud data",
    description: "Analysis is deterministic. Narration is optional, and receives a bounded summary.",
  },
  {
    title: "Nothing installed in your account",
    description: "One read-only role from a template you can read first, revocable any time.",
  },
];
---

<BaseLayout
  description="CloudoX turns AWS evidence into an explainable model of workloads, exposure, cost drivers, and change — one focused view per stakeholder, every statement traceable to the resource it came from. Understand any cloud environment in under 30 minutes."
>
  <section class="home-hero constellation-hero">
    <div class="hero-atmosphere" aria-hidden="true"></div>
    <div class="container-page hero-composition">
      <div class="hero-copy">
        <p class="hero-eyebrow">CLOUD KNOWLEDGE, EXPLAINED.</p>
        <h1>Understand your cloud.<span>In under 30 minutes.</span></h1>
        <p class="hero-description">See how your AWS workloads connect, what changed, and why it matters. Every finding backed by evidence.</p>
        <EarlyAccessForm />
      </div>
      <KnowledgeConstellation />
    </div>
    <div class="container-page hero-baseline"><span>AWS-first · Read-only access</span><span>Deterministic analysis · Optional AI narration</span><a href="#outcomes">Explore a real environment <span aria-hidden="true">↓</span></a></div>
  </section>

  <Section
    id="outcomes"
    class="outcomes-section"
    eyebrow="INSIDE CLOUDOX"
    title="From an unfamiliar cloud to a clear picture."
    subtitle="Explore a real, sanitized AWS environment. See its structure, understand a change, and follow the evidence."
  >
    <ProductShowcase />
  </Section>

  <section class="home-views" aria-labelledby="home-views-title">
    <div class="container-page">
      <header class="section-intro">
        <div><p class="eyebrow">KNOWLEDGE VIEWS</p><h2 id="home-views-title">One environment.<br />Six ways to read it.</h2></div>
        <div class="section-context"><p>Different questions. The same evidence. Choose a perspective to see what it leads with in the published example.</p><a href="/product#knowledge-views">How views are built <span aria-hidden="true">→</span></a></div>
      </header>
      <AudienceViews />
    </div>
  </section>

  <section class="home-boundaries" aria-labelledby="home-boundaries-title">
    <div class="container-page boundary-layout">
      <header>
        <p class="eyebrow">BUILT ON TRUST</p>
        <h2 id="home-boundaries-title">Clear knowledge.<br />Clear boundaries.</h2>
        <p class="boundary-intro">Understand your environment with a clear account of what CloudoX reads, how it reasons, and where AI fits.</p>
        <a class="boundary-link" href="/security">Permissions and limitations <span aria-hidden="true">→</span></a>
      </header>
      <ol class="boundary-principles">
        {boundary.map((item, i) => (
          <li><span class="principle-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <CTA
    title="Bring us an environment you don't fully understand."
    subtitle="Early access is for cloud consultants, architects, and engineers working in real, messy AWS estates. Tell us about yours and we'll show you what CloudoX makes of it."
    primary={{ label: "Request early access", href: "/contact" }}
    secondary={{ label: "Book a 30-min walkthrough", href: SITE.bookingUrl }}
  />
</BaseLayout>
