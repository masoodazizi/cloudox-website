---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import FeatureGrid from "@components/FeatureGrid.astro";
import CTA from "@components/CTA.astro";
import { SITE } from "@/config/site";

const capabilities = [
  {
    title: "Multi-account, multi-region",
    description:
      "Discover AWS Organizations across accounts and regions in a single, coherent view.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>`,
  },
  {
    title: "Evidence-based",
    description:
      "Every important finding cites tags, Config data, or AWS-native signals — never invented.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 7v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V7l-8-5z"/><path d="m9 12 2 2 4-4"/></svg>`,
  },
  {
    title: "Stakeholder-ready reports",
    description:
      "Clean Markdown documentation: architecture, networking, security, observability, findings.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>`,
  },
];

const steps = [
  {
    title: "Connect",
    description:
      "Read-only access to an AWS Organization, account set, or single account.",
  },
  {
    title: "Discover",
    description:
      "Collect AWS-native data across accounts and regions and build a typed knowledge graph.",
  },
  {
    title: "Report",
    description:
      "Generate a clean Markdown discovery report — ready to share with stakeholders.",
  },
];

const reportingTargets = [
  {
    title: "CloudoX Dashboard",
    description:
      "Browse reports with sidebar navigation, search, and theming. A public preview is live with a sanitised example report.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="14" rx="2"/><line x1="2" y1="9" x2="22" y2="9"/><line x1="9" y1="14" x2="15" y2="14"/></svg>`,
    href: "https://preview.cloudox.io",
    badge: "Live preview",
    ctaLabel: "Open dashboard",
  },
  {
    title: "Git repository",
    description:
      "Commit reports as plain Markdown. Diff, review, and version discovery documentation like code.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="19" r="2.5"/><path d="M6 8.5v3a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3v-3"/><line x1="12" y1="14.5" x2="12" y2="16.5"/></svg>`,
    href: "https://github.com/masoodazizi/cloudox-example-report",
    badge: "Live example",
    ctaLabel: "View example on GitHub",
  },
  {
    title: "Confluence",
    description:
      "Publish reports into Confluence spaces and pages alongside the rest of your team documentation.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16a4 4 0 0 0 4 4h3l3-4-3-4H7a4 4 0 0 0-4 4z"/><path d="M21 8a4 4 0 0 0-4-4h-3l-3 4 3 4h3a4 4 0 0 0 4-4z"/></svg>`,
    badge: "Planned",
    badgeVariant: "muted" as const,
  },
  {
    title: "Notion",
    description:
      "Push reports into a Notion workspace as native pages, organised by account and environment.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6H6a2 2 0 0 0-2 2z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>`,
    badge: "Planned",
    badgeVariant: "muted" as const,
  },
];
---

<BaseLayout
  title="Understand cloud environments in 30 minutes"
  description="CloudoX helps consultants and cloud engineers understand cloud environments in 30 minutes and generate stakeholder-ready discovery reports — AWS-first today, multi-cloud tomorrow."
>
  <Hero
    eyebrow="CLOUD DISCOVERY, INTELLIGENT DOCUMENTATION"
    title="Understand any cloud environment in under 30 minutes."
    subtitle="CloudoX scans AWS Organizations across accounts and regions, builds a structured knowledge model, and generates stakeholder-ready discovery reports."
    primaryCta={{ label: "Request Early Access", href: "/contact" }}
    secondaryCta={{ label: "Book a call", href: SITE.bookingUrl }}
  />

  <Section
    eyebrow="WHY CLOUDOX"
    title="A trustworthy discovery platform — not a console crawler."
    subtitle="AWS-first today. Built to evolve to Azure, GCP, and broader multi-cloud."
  >
    <FeatureGrid features={capabilities} cols={3} />
  </Section>

  <Section
    eyebrow="HOW IT WORKS"
    title="From AWS APIs to a discovery report."
    muted
  >
    <ol class="grid gap-5 md:grid-cols-3">
      {steps.map((step, i) => (
        <li class="surface p-6">
          <span
            class="inline-flex h-8 w-8 items-center justify-center rounded-md font-mono text-sm mb-4"
            style="background: color-mix(in oklab, var(--accent) 12%, transparent); color: var(--accent);"
          >
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="text-base font-semibold mb-2">{step.title}</h3>
          <p class="text-sm muted leading-relaxed">{step.description}</p>
        </li>
      ))}
    </ol>
    <div class="mt-10 flex justify-center">
      <a href="/how-it-works" class="btn btn-secondary">Read the full workflow</a>
    </div>
  </Section>

  <Section
    eyebrow="WHERE REPORTS LIVE"
    title="Discovery reports, where your team already works."
    subtitle="CloudoX writes clean Markdown, so the same report can live in a hosted dashboard, your Git repository, or the documentation tool your team already uses. Two destinations are live today; more are on the roadmap."
  >
    <FeatureGrid features={reportingTargets} cols={4} />
  </Section>

  <CTA
    title="Be among the first consultants to use CloudoX."
    subtitle="Early access for cloud consultants, architects, and engineers. No marketing fluff — just real environments and real reports."
    primary={{ label: "Request Early Access", href: "/contact" }}
    secondary={{ label: "Book a call", href: SITE.bookingUrl }}
  />
</BaseLayout>
