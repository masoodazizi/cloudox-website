---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import FeatureGrid from "@components/FeatureGrid.astro";
import CTA from "@components/CTA.astro";
import { SITE } from "@/config/site";

const capabilities = [
  {
    title: "Evidence-grounded knowledge",
    description:
      "A typed knowledge graph of accounts, environments, workloads, and relationships — every important finding cites AWS-native evidence, never invented.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 7v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V7l-8-5z"/><path d="m9 12 2 2 4-4"/></svg>`,
  },
  {
    title: "Interpretation, not inventory",
    description:
      "CloudoX explains how the environment works — production workloads, internet exposure, ownership signals — instead of listing resources.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2"/></svg>`,
  },
  {
    title: "Documentation & dashboard",
    description:
      "Read the same knowledge as stakeholder-ready Markdown, architecture diagrams, or in a hosted dashboard. One source of truth, many views.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="14" rx="2"/><line x1="2" y1="9" x2="22" y2="9"/><line x1="9" y1="14" x2="15" y2="14"/></svg>`,
  },
];

const questions = [
  {
    q: "What exists?",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>`,
  },
  {
    q: "How does it work?",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915Z"/><circle cx="12" cy="12" r="3"/></svg>`,
  },
  {
    q: "Why does it exist?",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>`,
  },
  {
    q: "What changed?",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><path d="M11 18H8a2 2 0 0 1-2-2V9"/></svg>`,
  },
  {
    q: "How is it evolving?",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
  },
  {
    q: "What should we consider next?",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>`,
  },
];

const flow = ["Cloud environment", "Discovery", "Knowledge graph", "Interpretation", "Documentation & insights"];

const steps = [
  {
    title: "Connect",
    description:
      "Read-only access to an AWS Organization, account set, or single account.",
  },
  {
    title: "Discover & model",
    description:
      "Collect AWS-native data across accounts and regions and build a typed knowledge graph.",
  },
  {
    title: "Understand",
    description:
      "Read the interpreted environment as a stakeholder-ready report and an architecture view.",
  },
];
---

<BaseLayout
  description="CloudoX is the intelligent cloud knowledge platform that continuously discovers, documents, analyzes, and tracks the evolution of your cloud infrastructure. Understand any cloud environment in under 30 minutes."
>
  <Hero
    eyebrow="INTELLIGENT CLOUD KNOWLEDGE PLATFORM"
    title="Understand any cloud environment in under 30 minutes."
    subtitle="The intelligent cloud knowledge platform that continuously discovers, documents, analyzes, and tracks the evolution of your cloud infrastructure."
    primaryCta={{ label: "Request Early Access", href: "/contact" }}
    secondaryCta={{ label: "Book a call", href: SITE.bookingUrl }}
  />

  <Section
    eyebrow="WHAT CLOUDOX DOES"
    title="A cloud knowledge platform — not just a documentation tool."
    subtitle="CloudoX turns AWS-native evidence into a structured knowledge graph, then makes that knowledge readable. AWS-first today, built to evolve to Azure, GCP, and broader multi-cloud."
  >
    <FeatureGrid features={capabilities} cols={3} />
  </Section>

  <Section
    eyebrow="THE QUESTIONS IT ANSWERS"
    title="From raw cloud APIs to real understanding."
    subtitle="CloudoX builds and maintains cloud knowledge in a clear path — so you can answer the questions that actually matter."
    muted
  >
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-3 mb-10">
      {flow.map((node, i) => (
        <li class="flex items-center gap-2">
          <span class="surface px-3 py-2 text-sm font-medium">{node}</span>
          {i < flow.length - 1 && (
            <span aria-hidden="true" class="font-mono text-sm" style="color: var(--accent);">→</span>
          )}
        </li>
      ))}
    </ol>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {questions.map(({ q, icon }, i) => (
        <li class="surface group relative flex items-start gap-4 p-5 transition hover:-translate-y-0.5 hover:shadow-sm">
          <span
            class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg"
            style="background: color-mix(in oklab, var(--accent) 12%, transparent); color: var(--accent);"
            aria-hidden="true"
            set:html={icon}
          />
          <div>
            <span class="block font-mono text-xs mb-1" style="color: var(--accent);">{String(i + 1).padStart(2, "0")}</span>
            <span class="text-base font-semibold leading-snug">{q}</span>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section
    eyebrow="HOW IT WORKS"
    title="From AWS APIs to a discovery report."
  >
    <ol class="grid gap-5 md:grid-cols-3">
      {steps.map((step, i) => (
        <li class="surface p-6">
          <span
            class="inline-flex h-8 w-8 items-center justify-center rounded-md font-mono text-sm mb-4"
            style="background: color-mix(in oklab, var(--accent) 12%, transparent); color: var(--accent);"
          >
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="text-base font-semibold mb-2">{step.title}</h3>
          <p class="text-sm muted leading-relaxed">{step.description}</p>
        </li>
      ))}
    </ol>
    <div class="mt-10 flex justify-center">
      <a href="/how-it-works" class="btn btn-secondary">Read the full workflow</a>
    </div>
  </Section>

  <CTA
    title="Be among the first consultants to use CloudoX."
    subtitle="Early access for cloud consultants, architects, and engineers. No marketing fluff — just real environments and real reports."
    primary={{ label: "Request Early Access", href: "/contact" }}
    secondary={{ label: "Book a call", href: SITE.bookingUrl }}
  />
</BaseLayout>
