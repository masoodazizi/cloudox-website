---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import FeatureGrid from "@components/FeatureGrid.astro";
import CTA from "@components/CTA.astro";
import { SITE } from "@/config/site";

// The CloudoX pipeline — one evidence-grounded foundation, many lenses.
const pipeline = [
  "Cloud environment",
  "Discovery",
  "Knowledge graph",
  "Interpretation",
  "Knowledge Intelligence",
  "Knowledge Views",
  "AI-narrated understanding",
];

const foundations = [
  {
    title: "Knowledge graph, not inventory",
    description:
      "A typed graph of accounts, environments, workloads, systems, and their relationships — the canonical record of what exists and how it connects. Not a flat list of resources.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="6" r="2.5"/><circle cx="19" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="M7 7.5 10.5 16M17 7.5 13.5 16M7.5 6h9"/></svg>`,
  },
  {
    title: "Interpretation, not guesswork",
    description:
      "Deterministic logic classifies environments, groups workloads, and detects internet exposure — then a reusable interpretation layer captures the meaning once, for every channel to read.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2"/></svg>`,
  },
  {
    title: "Understanding, framed for you",
    description:
      "The same interpreted knowledge is projected into audience-specific Knowledge Views and narrated in plain language — so each stakeholder gets the explanation they need, never a different truth.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>`,
  },
];

// The six Knowledge Views: one environment, every audience.
const views = [
  { name: "Executive", focus: "Risk, decisions, and cost at a glance — no inventory." },
  { name: "Architect", focus: "Architecture, workloads, dependencies, and design risks." },
  { name: "Operations", focus: "Connectivity, observability, and recovery readiness." },
  { name: "Security", focus: "Exposure, identity, governance, and evidence gaps." },
  { name: "FinOps", focus: "Cost drivers and optimization in architectural context." },
  { name: "Generic", focus: "A balanced, full-depth read for any technical reader." },
];

// Intelligence across domains — generated once, consumed everywhere.
const intelligence = [
  {
    title: "Architecture intelligence",
    description:
      "Workloads, systems, dependencies, and design risks — what the environment is, and what to reconsider.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>`,
  },
  {
    title: "Operational intelligence",
    description:
      "Connectivity, routing, observability, and backup coverage — where operations and recovery are exposed.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
  },
  {
    title: "Security intelligence",
    description:
      "Internet exposure, identity boundaries, and governance gaps — labelled by confidence, never invented.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 7v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V7l-8-5z"/><path d="m9 12 2 2 4-4"/></svg>`,
  },
  {
    title: "Cost intelligence",
    description:
      "Spend explained in the context of the architecture CloudoX already understands — the patterns behind the bill.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  },
  {
    title: "Evolution intelligence",
    description:
      "What changed since the last discovery — new regions, a workload that grew, an exposure that opened.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><path d="M11 18H8a2 2 0 0 1-2-2V9"/></svg>`,
  },
];

const differentiators = [
  {
    title: "Knowledge-first",
    description:
      "The product is the knowledge graph and its interpretation. Reports, the dashboard, and exports are lenses on top — never the thing itself.",
  },
  {
    title: "Evidence-grounded",
    description:
      "Every important statement cites AWS-native evidence or is clearly labelled as inferred, with a confidence level you can defend.",
  },
  {
    title: "Multi-account, multi-region",
    description:
      "Discover an entire AWS Organization in one pass — accounts, regions, and shared services merged into a single knowledge graph.",
  },
  {
    title: "AI-assisted, not AI-invented",
    description:
      "Deterministic analysis decides the facts and the meaning. AI only narrates interpreted knowledge — it is never the source of truth.",
  },
];

const steps = [
  {
    title: "Connect",
    description:
      "Read-only access to an AWS Organization, account set, or single account. Nothing is created or modified.",
  },
  {
    title: "Discover & interpret",
    description:
      "Collect AWS-native data across accounts and regions, build a typed knowledge graph, and interpret what it means.",
  },
  {
    title: "Understand",
    description:
      "Read audience-specific Knowledge Views — AI-narrated, evidence-grounded, ready to share with stakeholders.",
  },
];
---

<BaseLayout
  description="CloudoX is the intelligent cloud knowledge platform. It turns AWS-native evidence into a knowledge graph, interprets it, and projects audience-specific understanding. Understand any cloud environment in under 30 minutes."
>
  <Hero
    eyebrow="INTELLIGENT CLOUD KNOWLEDGE PLATFORM"
    title="Understand any cloud environment in under 30 minutes."
    subtitle="CloudoX turns AWS-native evidence into a knowledge graph, interprets it, and projects audience-specific understanding for executives, architects, operations, security, and FinOps — grounded in evidence, never invented."
    primaryCta={{ label: "Request Early Access", href: "/contact" }}
    secondaryCta={{ label: "Book a call", href: SITE.bookingUrl }}
  />

  <Section
    eyebrow="WHAT CLOUDOX DOES"
    title="A cloud knowledge platform — not another inventory or report tool."
    subtitle="CloudoX builds one evidence-grounded foundation and interprets it once, then frames that understanding for whoever is reading. The same knowledge serves every audience and channel."
  >
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-3 mb-12">
      {pipeline.map((node, i) => (
        <li class="flex items-center gap-2">
          <span class="surface px-3 py-2 text-sm font-medium">{node}</span>
          {i < pipeline.length - 1 && (
            <span aria-hidden="true" class="font-mono text-sm" style="color: var(--accent);">→</span>
          )}
        </li>
      ))}
    </ol>
    <FeatureGrid features={foundations} cols={3} />
  </Section>

  <Section
    eyebrow="KNOWLEDGE VIEWS"
    title="One environment. Every audience."
    subtitle="Different stakeholders ask different questions of the same cloud. CloudoX projects the interpreted knowledge into audience-specific views — different explanations and priorities, never different truths."
    muted
  >
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {views.map((v, i) => (
        <li class="surface group relative flex items-start gap-4 p-5 transition hover:-translate-y-0.5 hover:shadow-sm">
          <span
            class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg font-mono text-sm"
            style="background: color-mix(in oklab, var(--accent) 12%, transparent); color: var(--accent);"
            aria-hidden="true"
          >
            {String(i + 1).padStart(2, "0")}
          </span>
          <div>
            <span class="block text-base font-semibold leading-snug mb-1">{v.name} View</span>
            <span class="text-sm muted leading-relaxed">{v.focus}</span>
          </div>
        </li>
      ))}
    </ul>
    <div class="mt-10">
      <a href="/knowledge-views" class="btn btn-secondary">Explore Knowledge Views</a>
    </div>
  </Section>

  <Section
    eyebrow="INTELLIGENCE ACROSS DOMAINS"
    title="From facts to what actually matters."
    subtitle="CloudoX generates ranked, evidence-grounded intelligence once per environment — findings, risks, and opportunities across architecture, operations, security, cost, and change — then every view selects what its audience needs."
  >
    <FeatureGrid features={intelligence} cols={3} />
  </Section>

  <Section
    eyebrow="WHY CLOUDOX"
    title="Built to be trusted."
    subtitle="Cloud consultants and engineers are accountable for what they hand to stakeholders. CloudoX is built so every line can be defended."
    muted
  >
    <div class="grid gap-5 sm:grid-cols-2">
      {differentiators.map((d) => (
        <div class="surface p-6">
          <h3 class="text-base font-semibold mb-2">{d.title}</h3>
          <p class="text-sm muted leading-relaxed">{d.description}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section
    eyebrow="HOW IT WORKS"
    title="From AWS APIs to understanding."
  >
    <ol class="grid gap-5 md:grid-cols-3">
      {steps.map((step, i) => (
        <li class="surface p-6">
          <span
            class="inline-flex h-8 w-8 items-center justify-center rounded-md font-mono text-sm mb-4"
            style="background: color-mix(in oklab, var(--accent) 12%, transparent); color: var(--accent);"
          >
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="text-base font-semibold mb-2">{step.title}</h3>
          <p class="text-sm muted leading-relaxed">{step.description}</p>
        </li>
      ))}
    </ol>
    <div class="mt-10 flex justify-center">
      <a href="/how-it-works" class="btn btn-secondary">Read the full workflow</a>
    </div>
  </Section>

  <CTA
    title="See CloudoX on a real environment."
    subtitle="Early access for cloud consultants, architects, and engineers. No marketing fluff — just real environments and understanding you can trust."
    primary={{ label: "Request Early Access", href: "/contact" }}
    secondary={{ label: "Book a call", href: SITE.bookingUrl }}
  />
</BaseLayout>
