---
import "../styles/global.css";
// Self-hosted via @fontsource — no request to fonts.googleapis.com /
// fonts.gstatic.com on any page load. See docs/legal-privacy-implementation-audit.md.
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@/config/site";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Alternative text for the social card image. */
  imageAlt?: string;
  canonical?: string;
  noindex?: boolean;
  /**
   * Open Graph type. Exactly one `og:type` is emitted per page, from here —
   * pages must not add their own, or consumers see conflicting values.
   */
  ogType?: "website" | "article";
  /** JSON-LD blocks to inject in addition to the base Organization/WebSite schemas. */
  jsonLd?: object[];
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  imageAlt = `${SITE.name} — ${SITE.tagline}`,
  canonical,
  noindex = false,
  ogType = "website",
  jsonLd = [],
} = Astro.props as Props;

const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const ogImageURL = new URL(image, Astro.site ?? SITE.url).toString();

// Base structured data present on every page.
const baseSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${SITE.url}/#organization`,
    name: SITE.name,
    url: SITE.url,
    logo: {
      "@type": "ImageObject",
      url: `${SITE.url}/brand/logo/v4/logo-v4-bright-bg.png`,
      width: 2454,
      height: 448,
    },
    description: SITE.description,
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "sales",
      url: `${SITE.url}/contact`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    description: SITE.tagline,
    publisher: { "@id": `${SITE.url}/#organization` },
    // SiteNavigationElement tells Google which pages to surface as sitelinks.
    hasPart: [
      { "@type": "SiteNavigationElement", name: "Product",      url: `${SITE.url}/product/` },
      { "@type": "SiteNavigationElement", name: "How It Works", url: `${SITE.url}/how-it-works/` },
      { "@type": "SiteNavigationElement", name: "Use Cases",    url: `${SITE.url}/use-cases/` },
      { "@type": "SiteNavigationElement", name: "Security",     url: `${SITE.url}/security/` },
      { "@type": "SiteNavigationElement", name: "Docs",         url: `${SITE.url}/docs/` },
      { "@type": "SiteNavigationElement", name: "Blog",         url: `${SITE.url}/blog/` },
      { "@type": "SiteNavigationElement", name: "Early Access", url: `${SITE.url}/contact/` },
    ],
  },
];

const allSchemas = [...baseSchemas, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Runs before first paint so an explicit theme choice (stored by the
        header's toggle) never flashes the system-default theme first. With
        no stored choice, this leaves `data-theme` unset and the plain-CSS
        `prefers-color-scheme` rules in global.css keep driving the theme. */}
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {
          /* ignore */
        }
        var isDark =
          stored === "dark" ||
          (stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        if (stored === "light" || stored === "dark") {
          document.documentElement.setAttribute("data-theme", stored);
        }
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", isDark ? "#0a0d12" : "#ffffff");
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png?v=4" />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/logo/v4/logo4-favicon-bb512.png?v=4" />
    <link rel="apple-touch-icon" href="/brand/logo/v4/logo4-favicon-bb512.png?v=4" />
    <link rel="canonical" href={canonicalURL} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta name="theme-color" content="#ffffff" />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {allSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:btn focus:btn-primary"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
