---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  eyebrow: string;
  description: string;
  lastUpdated?: string;
  jsonLd?: object[];
}

const { title, eyebrow, description, lastUpdated, jsonLd = [] } = Astro.props as Props;
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="container-narrow py-14 md:py-20">
    <header class="mb-10">
      <p class="eyebrow mb-3">{eyebrow}</p>
      <h1 class="text-3xl md:text-4xl font-semibold tracking-tight">{title}</h1>
      {lastUpdated && <p class="mt-3 text-sm muted">Last updated: {lastUpdated}</p>}
    </header>
    <article class="prose-cloudox max-w-none">
      <slot />
    </article>
  </div>
</BaseLayout>
