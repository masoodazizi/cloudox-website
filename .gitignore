# Build output
dist/
.astro/

# Dependencies
node_modules/

# Platform-specific lockfile.
# Astro/Vite (>=8) pull in `rolldown`, which has per-platform native bindings.
# A lockfile generated on macOS does not include Linux bindings, breaking
# Cloudflare Pages builds (npm/cli#4828). Letting Cloudflare run `npm install`
# fresh on Linux resolves this. The site is fully static and uses caret
# semver ranges, so the loss of strict reproducibility is acceptable.
package-lock.json

